---
import { business } from "@/config/business";

// Set PUBLIC_GHL_WEBHOOK_URL in .env or Cloudflare env vars to activate this form.
const webhookUrl = import.meta.env.PUBLIC_GHL_WEBHOOK_URL ?? "";
---

{webhookUrl ? (
  <form id="contact-form" class="space-y-5" novalidate>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="cf-name" class="block text-sm font-medium text-neutral-700 mb-1.5">Full Name *</label>
        <input
          id="cf-name"
          type="text"
          name="name"
          placeholder="Jane Smith"
          required
          class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition"
        />
      </div>
      <div>
        <label for="cf-phone" class="block text-sm font-medium text-neutral-700 mb-1.5">Phone Number *</label>
        <input
          id="cf-phone"
          type="tel"
          name="phone"
          placeholder="(555) 555-5555"
          required
          class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition"
        />
      </div>
    </div>

    <div>
      <label for="cf-email" class="block text-sm font-medium text-neutral-700 mb-1.5">Email Address</label>
      <input
        id="cf-email"
        type="email"
        name="email"
        placeholder="jane@example.com"
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition"
      />
    </div>

    <div>
      <label for="cf-service" class="block text-sm font-medium text-neutral-700 mb-1.5">Service Needed</label>
      <select
        id="cf-service"
        name="service"
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition bg-white"
      >
        <option value="">Select a service (optional)</option>
        {business.primaryServices.map((s) => (
          <option value={s}>{s}</option>
        ))}
        <option value="Not sure">Not sure — need advice</option>
      </select>
    </div>

    <div>
      <label for="cf-message" class="block text-sm font-medium text-neutral-700 mb-1.5">Message *</label>
      <textarea
        id="cf-message"
        name="message"
        required
        placeholder="Tell us about your project or what you need…"
        rows="4"
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition resize-none"
      ></textarea>
    </div>

    <input type="hidden" name="source" value="Website — Contact Form" />

    <button
      type="submit"
      class="w-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-3.5 rounded-lg transition-colors duration-200 shadow-sm text-base"
    >
      Send Message →
    </button>

    <div id="contact-form-result" class="hidden text-center py-2 text-sm font-medium"></div>
  </form>
) : (
  <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-8 text-center">
    <p class="text-neutral-600 mb-4">The best way to reach us is by phone:</p>
    <a
      href={`tel:${business.phoneRaw}`}
      class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors text-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
      </svg>
      {business.phone}
    </a>
    <p class="text-neutral-400 text-xs mt-4">
      Or email us at <a href={`mailto:${business.email}`} class="text-accent-600 hover:underline">{business.email}</a>
    </p>
  </div>
)}

{webhookUrl && (
  <script define:vars={{ webhookUrl }}>
    const form = document.getElementById("contact-form");
    const result = document.getElementById("contact-form-result");
    if (form && result) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const btn = form.querySelector("button[type=submit]");
        btn.textContent = "Sending…";
        btn.disabled = true;
        try {
          const res = await fetch(webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          result.classList.remove("hidden");
          if (res.ok) {
            result.className = "text-center py-2 text-sm font-medium text-green-600";
            result.textContent = "✓ Message sent! We'll be in touch within one business day.";
            form.reset();
          } else {
            result.className = "text-center py-2 text-sm font-medium text-red-600";
            result.textContent = "Something went wrong. Please call us directly.";
          }
        } catch {
          result.classList.remove("hidden");
          result.className = "text-center py-2 text-sm font-medium text-red-600";
          result.textContent = "Error sending. Please call us directly.";
        }
        btn.textContent = "Send Message →";
        btn.disabled = false;
      });
    }
  </script>
)}
