---
import { business } from "@/config/business";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? business.website;
const id = `${siteUrl}/#business`;

const sameAs = Object.values(business.socials).filter(Boolean) as string[];

const serviceSchemas = business.primaryServices.map((service, index) => ({
  "@type": "Service",
  "@id": `${siteUrl}/#service-${index + 1}`,
  name: service,
  provider: {
    "@id": id,
  },
  areaServed: business.serviceAreas,
  serviceType: service,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: business.name,
    url: siteUrl,
    description: business.tagline,
    inLanguage: "en-US",
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteUrl}/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: business.name,
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    description: business.tagline,
    telephone: business.phone,
    email: business.email,
    areaServed: business.serviceAreas,
    sameAs,
    contactPoint: {
      "@type": "ContactPoint",
      telephone: business.phone,
      contactType: "sales",
      areaServed: business.serviceAreas,
      availableLanguage: ["English"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": id,
    name: business.name,
    description: business.tagline,
    url: siteUrl,
    telephone: business.phone,
    email: business.email,
    foundingDate: String(business.yearFounded),
    priceRange: "$$",
    address: {
      "@type": "PostalAddress",
      streetAddress: business.address.streetAddress,
      addressLocality: business.address.addressLocality,
      addressRegion: business.address.addressRegion,
      postalCode: business.address.postalCode,
      addressCountry: business.address.addressCountry,
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: business.lat,
      longitude: business.lng,
    },
    areaServed: business.serviceAreas,
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: String(business.rating),
      reviewCount: String(business.reviewCount),
      bestRating: "5",
      worstRating: "1",
    },
    makesOffer: serviceSchemas,
    openingHours: Object.entries(business.businessHours).map(([day, hours]) => `${day} ${hours}`).filter((entry) => entry !== "Saturday Closed" && entry !== "Sunday Closed"),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What services does The Lead Venture provide?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The Lead Venture provides website design, local SEO, review systems, AI receptionist automation, missed-call text-back, and digital marketing for home service contractors.",
        },
      },
      {
        "@type": "Question",
        name: "Do you work with local contractors and home service businesses?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. The Lead Venture specializes in helping local contractors and home service businesses generate more qualified leads, improve online visibility, and automate follow-up.",
        },
      },
      {
        "@type": "Question",
        name: "How quickly can a contractor get started?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Your website is live in as little as 72 hours, with the full system — CRM, automations, and review funnels — typically set up in 3 to 7 days depending on scope and asset readiness.",
        },
      },
    ],
  },
  ...serviceSchemas,
];
---

{schema.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
