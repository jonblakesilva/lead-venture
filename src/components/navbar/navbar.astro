---
import { getCollection } from "astro:content";
import { business } from "@/config/business";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const topLocations = (await getCollection("locations", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(path + "/");
}
---

<nav id="site-nav" aria-label="Main navigation">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="flex items-center justify-between h-16 lg:h-18">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label={business.name}>
        <span class="font-heading font-bold text-xl text-primary-900 leading-none">
          {business.name}
        </span>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden lg:flex items-center gap-0.5" role="list">

        <!-- Services dropdown -->
        <li class="relative group">
          <button
            class:list={[
              "flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 cursor-default",
              isActive("/services")
                ? "text-accent-600 bg-accent-50"
                : "text-neutral-600 hover:text-primary-900 hover:bg-neutral-100",
            ]}
            aria-haspopup="true"
          >
            Services
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-1.5 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50">
            <div class="bg-white rounded-xl shadow-lg border border-neutral-200 py-1.5 min-w-56">
              {services.map((service) => (
                <a
                  href={`/services/${service.data.urlSlug}`}
                  class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-neutral-700 hover:text-primary-900 hover:bg-neutral-50 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-accent-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                  {service.data.title}
                </a>
              ))}
              <div class="my-1 border-t border-neutral-100"></div>
              <a href="/services" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-accent-600 hover:bg-accent-50 transition-colors">
                All Services →
              </a>
            </div>
          </div>
        </li>

        <!-- Service Areas dropdown -->
        <li class="relative group">
          <button
            class:list={[
              "flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 cursor-default",
              isActive("/service-areas")
                ? "text-accent-600 bg-accent-50"
                : "text-neutral-600 hover:text-primary-900 hover:bg-neutral-100",
            ]}
            aria-haspopup="true"
          >
            Service Areas
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-1.5 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50">
            <div class="bg-white rounded-xl shadow-lg border border-neutral-200 py-1.5 min-w-48">
              {topLocations.map((loc) => (
                <a
                  href={`/service-areas/${loc.data.urlSlug}`}
                  class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-neutral-700 hover:text-primary-900 hover:bg-neutral-50 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {loc.data.city}, {loc.data.state}
                </a>
              ))}
              <div class="my-1 border-t border-neutral-100"></div>
              <a href="/service-areas" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-accent-600 hover:bg-accent-50 transition-colors">
                All Service Areas →
              </a>
            </div>
          </div>
        </li>

        <!-- Flat links -->
        {[
          { title: "Gallery",   path: "/gallery" },
          { title: "Proof",     path: "/proof" },
          { title: "Blog",      path: "/blog" },
          // { title: "Financing", path: "/financing" },
          { title: "Contact",   path: "/contact" },
        ].map((item) => (
          <li>
            <a
              href={item.path}
              class:list={[
                "px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150",
                isActive(item.path)
                  ? "text-accent-600 bg-accent-50"
                  : "text-neutral-600 hover:text-primary-900 hover:bg-neutral-100",
              ]}
            >
              {item.title}
            </a>
          </li>
        ))}

        <!-- Free Estimator (highlighted) -->
        <li>
          <a
            href="/tools/cost-estimator"
            class:list={[
              "px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150",
              isActive("/tools")
                ? "text-accent-600 bg-accent-50"
                : "text-accent-700 hover:text-accent-800 hover:bg-accent-50",
            ]}
          >
            Free Estimator
          </a>
        </li>
      </ul>

      <!-- Desktop CTAs -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={`tel:${business.phoneRaw}`}
          class="flex items-center gap-1.5 text-sm font-semibold text-primary-800 hover:text-accent-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          {business.phone}
        </a>
        <a
          href="/contact"
          class="bg-accent-500 hover:bg-accent-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors shadow-sm"
        >
          Get Free Quote
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-md text-neutral-600 hover:text-primary-900 hover:bg-neutral-100 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 py-4">
      <ul class="flex flex-col gap-0.5" role="list">

        <!-- Services accordion -->
        <li>
          <button
            data-accordion-toggle="mobile-services"
            class="flex items-center justify-between w-full px-3 py-2.5 rounded-md text-base font-medium text-neutral-700 hover:text-primary-900 hover:bg-neutral-100 transition-colors"
          >
            Services
            <svg data-chevron class="w-4 h-4 text-neutral-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="mobile-services" class="hidden pl-3 pb-1">
            {services.map((service) => (
              <a
                href={`/services/${service.data.urlSlug}`}
                class="block px-3 py-2 text-sm text-neutral-600 hover:text-primary-900 hover:bg-neutral-50 rounded-md transition-colors"
              >
                {service.data.title}
              </a>
            ))}
            <a href="/services" class="block px-3 py-2 text-sm font-medium text-accent-600 hover:bg-accent-50 rounded-md transition-colors mt-0.5">
              All Services →
            </a>
          </div>
        </li>

        <!-- Service Areas accordion -->
        <li>
          <button
            data-accordion-toggle="mobile-areas"
            class="flex items-center justify-between w-full px-3 py-2.5 rounded-md text-base font-medium text-neutral-700 hover:text-primary-900 hover:bg-neutral-100 transition-colors"
          >
            Service Areas
            <svg data-chevron class="w-4 h-4 text-neutral-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="mobile-areas" class="hidden pl-3 pb-1">
            {topLocations.map((loc) => (
              <a
                href={`/service-areas/${loc.data.urlSlug}`}
                class="block px-3 py-2 text-sm text-neutral-600 hover:text-primary-900 hover:bg-neutral-50 rounded-md transition-colors"
              >
                {loc.data.city}, {loc.data.state}
              </a>
            ))}
            <a href="/service-areas" class="block px-3 py-2 text-sm font-medium text-accent-600 hover:bg-accent-50 rounded-md transition-colors mt-0.5">
              All Service Areas →
            </a>
          </div>
        </li>

        <!-- Flat mobile links -->
        {[
          { title: "Gallery",         path: "/gallery" },
          { title: "Proof",           path: "/proof" },
          { title: "Blog",            path: "/blog" },
          // { title: "Financing",    path: "/financing" },
          { title: "Free Estimator",  path: "/tools/cost-estimator" },
          { title: "Contact",         path: "/contact" },
        ].map((item) => (
          <li>
            <a
              href={item.path}
              class="block px-3 py-2.5 rounded-md text-base font-medium text-neutral-700 hover:text-primary-900 hover:bg-neutral-100 transition-colors"
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-4 pt-4 border-t border-neutral-200 flex flex-col gap-3">
        <a
          href={`tel:${business.phoneRaw}`}
          class="flex items-center justify-center gap-2 w-full border-2 border-primary-800 text-primary-800 font-semibold py-3 rounded-lg hover:bg-primary-50 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          Call {business.phone}
        </a>
        <a
          href="/contact"
          class="block w-full bg-accent-500 hover:bg-accent-600 text-white text-center font-semibold py-3 rounded-lg transition-colors"
        >
          Get Free Quote
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  let _navAbort = new AbortController();

  function initMobileNav() {
    _navAbort.abort();
    _navAbort = new AbortController();
    const { signal } = _navAbort;

    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    if (!btn || !menu) return;

    // Reset state
    menu.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn.setAttribute("aria-expanded", "false");

    btn.addEventListener("click", () => {
      const nowHidden = menu.classList.toggle("hidden");
      const nowOpen = !nowHidden;
      iconOpen?.classList.toggle("hidden", nowOpen);
      iconClose?.classList.toggle("hidden", !nowOpen);
      btn.setAttribute("aria-expanded", String(nowOpen));
    }, { signal });

    document.querySelectorAll<HTMLButtonElement>("[data-accordion-toggle]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const panel = document.getElementById(trigger.dataset.accordionToggle ?? "");
        if (!panel) return;
        panel.classList.toggle("hidden");
        trigger.querySelector("[data-chevron]")?.classList.toggle("rotate-180");
      }, { signal });
    });
  }

  document.addEventListener("astro:page-load", initMobileNav);
  initMobileNav(); // cover initial load if astro:page-load has already fired
</script>
