---
import { getCollection } from "astro:content";
import { business } from "@/config/business";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(path + "/");
}
---

<nav id="site-nav" aria-label="Main navigation" class="bg-[#181d2a] text-white">
  <div class="mx-auto max-w-(--breakpoint-xl) px-5">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label={business.name}>
        <span class="font-heading text-xl font-black leading-none text-white">{business.name}</span>
      </a>

      <button
        id="mobile-menu-btn"
        class="rounded-md p-2 text-white/90 transition-colors hover:bg-white/5 hover:text-white"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-white/10 py-4 lg:hidden">
      <ul class="flex flex-col gap-1" role="list">
        {[{ title: "Home", path: "/" }, { title: "Services", path: "/services" }, { title: "Pricing", path: "/pricing" }, { title: "Proof", path: "/proof" }, { title: "Resources", path: "/resources" }, { title: "About", path: "/about" }, { title: "Contact", path: "/contact" }].map((item) => (
          <li>
            <a href={item.path} class="block rounded-md px-3 py-2.5 text-base font-medium text-white/80 transition-colors hover:bg-white/5 hover:text-white">
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  let _navAbort = new AbortController();

  function initMobileNav() {
    _navAbort.abort();
    _navAbort = new AbortController();
    const { signal } = _navAbort;

    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    if (!btn || !menu) return;

    // Reset state
    menu.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn.setAttribute("aria-expanded", "false");

    btn.addEventListener("click", () => {
      const nowHidden = menu.classList.toggle("hidden");
      const nowOpen = !nowHidden;
      iconOpen?.classList.toggle("hidden", nowOpen);
      iconClose?.classList.toggle("hidden", !nowOpen);
      btn.setAttribute("aria-expanded", String(nowOpen));
    }, { signal });

    document.querySelectorAll<HTMLButtonElement>("[data-accordion-toggle]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const panel = document.getElementById(trigger.dataset.accordionToggle ?? "");
        if (!panel) return;
        panel.classList.toggle("hidden");
        trigger.querySelector("[data-chevron]")?.classList.toggle("rotate-180");
      }, { signal });
    });
  }

  document.addEventListener("astro:page-load", initMobileNav);
  initMobileNav(); // cover initial load if astro:page-load has already fired
</script>
