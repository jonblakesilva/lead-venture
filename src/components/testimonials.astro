---
import { business } from "@/config/business";

// Placeholder reviews shown when Google Places API is not yet configured.
// Replace these with real reviews from your Google Business Profile.
const fallbackReviews = [
  {
    name: "Sarah M.",
    city: "Your City, ST",
    stars: 5,
    text: "Absolutely incredible service. They showed up on time, did a thorough job, and cleaned up everything when they were done. I've used a lot of companies over the years and this team is by far the best.",
    service: "Service One",
    datePublished: "2024-01-15",
  },
  {
    name: "David R.",
    city: "Nearby City, ST",
    stars: 5,
    text: "Called on a Tuesday, they were here Wednesday morning. The technician explained everything clearly and the price matched the quote exactly. No hidden fees. I'll be a customer for life.",
    service: "Service Two",
    datePublished: "2024-02-20",
  },
  {
    name: "Jennifer L.",
    city: "Another City, ST",
    stars: 5,
    text: "I was nervous about the cost but their free estimate was honest and detailed. They finished ahead of schedule and the quality is outstanding. Highly recommend to anyone in the area.",
    service: "Service Three",
    datePublished: "2024-03-08",
  },
];

// Fetch live Google reviews at build time.
// Requires GOOGLE_PLACES_API_KEY (in .env or Cloudflare build env vars)
// and placeId set in business.ts.
// Falls back to fallbackReviews when either is missing.
type Review = {
  name: string;
  city: string;
  stars: number;
  text: string;
  service: string;
  datePublished: string;
};

let reviews: Review[] = fallbackReviews;
const placesKey = import.meta.env.GOOGLE_PLACES_API_KEY;

if (placesKey && business.placeId) {
  try {
    const fields = "reviews,rating,userRatingCount";
    const url = `https://places.googleapis.com/v1/places/${business.placeId}?fields=${fields}&key=${placesKey}&languageCode=en`;
    const res = await fetch(url, {
      headers: { "X-Goog-FieldMask": fields },
    });
    if (res.ok) {
      const data = await res.json();
      if (data.reviews?.length) {
        reviews = data.reviews.slice(0, 4).map((r: {
          authorAttribution?: { displayName?: string };
          rating?: number;
          text?: { text?: string };
          relativePublishTimeDescription?: string;
        }) => ({
          name: r.authorAttribution?.displayName ?? "Google Reviewer",
          city: "",
          stars: r.rating ?? 5,
          text: r.text?.text ?? "",
          service: "",
          datePublished: new Date().toISOString().split("T")[0],
        }));
      }
    }
  } catch {
    // silently fall back to placeholder reviews
  }
}

// Google review link — shown when either placeId or socials.google is set
const reviewUrl = business.placeId
  ? `https://search.google.com/local/reviews?placeid=${business.placeId}`
  : business.socials.google;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: business.rating,
    reviewCount: business.reviewCount,
    bestRating: "5",
    worstRating: "1",
  },
  review: reviews.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.name },
    reviewRating: { "@type": "Rating", ratingValue: String(t.stars), bestRating: "5" },
    reviewBody: t.text,
    datePublished: t.datePublished,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <!-- Header -->
    <div class="max-w-2xl" data-aos="fade-up">
      <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">Real Reviews</p>
      <h2 class="font-heading text-4xl lg:text-5xl font-bold text-primary-900">
        What Our Customers Say
      </h2>
      <p class="text-neutral-500 text-lg mt-4">
        Don't take our word for it — here's what real customers have to say.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6 mt-14">
      {reviews.slice(0, 3).map((t, i) => (
        <div
          data-aos="fade-up"
          data-aos-delay={(i + 1) * 100}
          class:list={[
            "flex flex-col bg-neutral-50 border border-neutral-200 rounded-2xl p-7",
            "hover:shadow-[var(--shadow-card-hover)] hover:border-neutral-300 transition-all duration-300",
          ]}
        >
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {Array.from({ length: t.stars }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-neutral-700 leading-relaxed text-sm flex-1">
            "{t.text}"
          </blockquote>

          <!-- Attribution -->
          <div class="mt-6 pt-4 border-t border-neutral-200 flex items-center justify-between">
            <div>
              <div class="font-semibold text-primary-900 text-sm">{t.name}</div>
              {t.city && <div class="text-neutral-400 text-xs mt-0.5">{t.city}</div>}
            </div>
            {t.service && (
              <span class="text-xs font-medium bg-primary-50 text-primary-700 px-2.5 py-1 rounded-full">
                {t.service}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Google review link -->
    {reviewUrl && (
      <div class="mt-10 text-center" data-aos="fade-up">
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-accent-600 transition-colors text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Read all reviews on Google
        </a>
      </div>
    )}
  </div>
</section>
