---
import { business } from "@/config/business";

// GHL webhook URL — set PUBLIC_GHL_WEBHOOK_URL in your .env or Cloudflare env vars.
// If not set, the form renders a "call us" fallback instead of submitting.
const webhookUrl = import.meta.env.PUBLIC_GHL_WEBHOOK_URL ?? "";
---

<section class="bg-primary-900 text-white overflow-hidden">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Headline + CTAs -->
      <div>
        <!-- Trust badge -->
        <div class="hero-1 inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white/90 text-sm font-medium px-4 py-2 rounded-full mb-6">
          <span class="flex">
            {"★★★★★".split("").map(() => (
              <span class="text-accent-400 text-xs">★</span>
            ))}
          </span>
          <span>Rated {business.rating}/5 · {business.reviewCount}+ Reviews</span>
        </div>

        <h1 class="hero-2 font-heading text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-white">
          Expert {business.niche} in {business.city}.
          <span class="text-accent-400"> Done Right.</span>
        </h1>

        <p class="hero-3 text-lg text-white/75 mt-5 max-w-lg leading-relaxed">
          {business.tagline} Serving {business.city}, {business.state} and a {business.serviceRadius}.
        </p>

        <!-- Primary CTAs -->
        <div class="hero-4 mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={`tel:${business.phoneRaw}`}
            class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold text-lg px-8 py-4 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
            </svg>
            Call {business.phone}
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold text-lg px-8 py-4 rounded-xl transition-all duration-200"
          >
            Get Free Quote
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Trust signals row -->
        <div class="hero-5 mt-10 flex flex-wrap gap-x-6 gap-y-2">
          {[
            "Licensed & Insured",
            "Free Estimates",
            business.guaranteeText,
          ].map((item) => (
            <span class="flex items-center gap-1.5 text-sm text-white/70">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </span>
          ))}
        </div>
      </div>

      <!-- Right: Quote form -->
      <div class="hero-card">
        <div class="bg-white rounded-2xl shadow-2xl p-8 text-neutral-900">
          <div class="flex items-center gap-2 mb-6">
            <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
            <span class="text-sm font-semibold text-neutral-600 uppercase tracking-wide">Request a Free Quote</span>
          </div>

          {webhookUrl ? (
            <form id="hero-form" class="space-y-4" novalidate>
              <input type="hidden" name="source" value="Website — Hero Form" />

              <div>
                <label for="hero-name" class="block text-sm font-medium text-neutral-700 mb-1.5">Your Name</label>
                <input
                  id="hero-name"
                  type="text"
                  name="name"
                  placeholder="Jane Smith"
                  required
                  class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition"
                />
              </div>

              <div>
                <label for="hero-phone" class="block text-sm font-medium text-neutral-700 mb-1.5">Phone Number</label>
                <input
                  id="hero-phone"
                  type="tel"
                  name="phone"
                  placeholder="(555) 555-5555"
                  required
                  class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition"
                />
              </div>

              <div>
                <label for="hero-service" class="block text-sm font-medium text-neutral-700 mb-1.5">Service Needed</label>
                <select
                  id="hero-service"
                  name="service"
                  required
                  class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition bg-white"
                >
                  <option value="" disabled selected>Select a service…</option>
                  {business.primaryServices.map((s) => (
                    <option value={s}>{s}</option>
                  ))}
                  <option value="Not sure">Not sure — need advice</option>
                </select>
              </div>

              <button
                type="submit"
                class="w-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-3.5 rounded-lg transition-colors duration-200 shadow-sm text-base"
              >
                Get My Free Quote →
              </button>

              <p class="text-xs text-neutral-400 text-center">No spam. We'll call within 1 business day.</p>
              <div id="hero-form-result" class="hidden text-center py-2 text-sm font-medium"></div>
            </form>
          ) : (
            <div class="text-center py-6">
              <p class="text-neutral-500 text-sm mb-4">Ready to get a quote? Give us a call:</p>
              <a
                href={`tel:${business.phoneRaw}`}
                class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors text-lg"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
                </svg>
                {business.phone}
              </a>
              <p class="text-neutral-400 text-xs mt-4">
                Or <a href="/contact" class="text-accent-600 hover:underline">fill out the contact form →</a>
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative bottom wave -->
  <div class="text-white">
    <svg viewBox="0 0 1440 40" xmlns="http://www.w3.org/2000/svg" class="block w-full" preserveAspectRatio="none">
      <path fill="#ffffff" d="M0,20 C360,40 1080,0 1440,20 L1440,40 L0,40 Z"/>
    </svg>
  </div>
</section>

{webhookUrl && (
  <script define:vars={{ webhookUrl }}>
    const form = document.getElementById("hero-form");
    const result = document.getElementById("hero-form-result");
    if (form && result) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = form.querySelector("button[type=submit]");
        btn.textContent = "Sending…";
        btn.disabled = true;
        try {
          const payload = Object.fromEntries(new FormData(form));
          const res = await fetch(webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          result.classList.remove("hidden");
          if (res.ok) {
            result.className = "text-center py-2 text-sm font-medium text-green-600";
            result.textContent = "✓ Received! We'll be in touch soon.";
            form.reset();
          } else {
            result.className = "text-center py-2 text-sm font-medium text-red-600";
            result.textContent = "Something went wrong. Please call us directly.";
          }
        } catch {
          result.classList.remove("hidden");
          result.className = "text-center py-2 text-sm font-medium text-red-600";
          result.textContent = "Error sending. Please call us directly.";
        }
        btn.textContent = "Get My Free Quote →";
        btn.disabled = false;
      });
    }
  </script>
)}
