---
import { business } from "@/config/business";

const year = new Date().getFullYear();

const quickLinks = [
  { title: "How It Works", path: "/about/how-it-works" },
  { title: "Meet the Team", path: "/about/team" },
  { title: "Trades We Serve", path: "/about/trades-we-serve" },
  { title: "Growth Playbooks", path: "/playbooks" },
  { title: "Blog", path: "/blog" },
  { title: "Calculators", path: "/resources/calculators" },
  { title: "Case Studies", path: "/proof/case-studies" },
  { title: "Testimonials", path: "/proof/testimonials" },
  { title: "Contact", path: "/contact" },
];
---

<footer class="bg-[#13151D] py-16 text-white">
  <div class="mx-auto grid max-w-(--breakpoint-xl) grid-cols-1 gap-8 px-5 md:grid-cols-4">
    <!-- Brand -->
    <div class="space-y-4">
      <a href="/" class="inline-block">
        <span class="font-heading text-2xl font-bold text-white">{business.name}</span>
      </a>
      <p class="text-sm text-white/60">Built tough for local service businesses.</p>
      {business.socials.facebook && (
        <div class="flex items-center gap-3 pt-4">
          <a href={business.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/80 transition-colors hover:bg-white/10">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      )}
    </div>

    <!-- Contact -->
    <div class="space-y-4">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white">Contact Us</h4>
      <ul class="space-y-3 text-sm text-white/60">
        <li class="flex gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-1 shrink-0"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a href={`tel:${business.phoneRaw}`} class="transition-colors hover:text-white">{business.phone}</a>
        </li>
        <li class="flex gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-1 shrink-0"><path d="M4 4h16c2 0 3 1 3 3v10c0 2-1 3-3 3H4c-2 0-3-1-3-3V7c0-2 1-3 3-3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 6l-10 7L2 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="flex flex-col">
            <a href={`mailto:${business.secondaryEmail}`} class="transition-colors hover:text-white">{business.secondaryEmail}</a>
            <a href={`mailto:${business.email}`} class="transition-colors hover:text-white">{business.email}</a>
          </div>
        </li>
        <li class="flex gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-1 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{business.address.streetAddress},<br/>{business.address.addressLocality}, {business.address.addressRegion} {business.address.postalCode}, US</span>
        </li>
      </ul>
    </div>

    <!-- Products -->
    <div class="space-y-4">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white">Products</h4>
      <ul class="space-y-2 text-sm text-white/60">
        {business.products.map((product) => (
          <li><a href={`/products/${product.slug}`} class="transition-colors hover:text-white">{product.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Quick Links -->
    <div class="space-y-4">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white">Quick Links</h4>
      <ul class="space-y-2 text-sm text-white/60">
        {quickLinks.map((link) => (
          <li><a href={link.path} class="transition-colors hover:text-white">{link.title}</a></li>
        ))}
        {business.directoryUrl && (
          <li><a href={business.directoryUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">Get Listed on the Directory</a></li>
        )}
        {business.crmLoginUrl && (
          <li><a href={business.crmLoginUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">Login to CRM</a></li>
        )}
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-12 flex max-w-(--breakpoint-xl) flex-col items-center gap-8 border-t border-white/10 px-5 pt-8 text-center text-sm text-white/60">
    <div class="max-w-4xl space-y-4 text-xs opacity-80">
      <p>Disclaimer: The information provided on this website, including cost estimates, checklists, and guides, is for informational purposes only. It is not professional advice. Actual project costs may vary based on specific conditions, contractor availability, and material prices. Always consult with a licensed and insured professional before making decisions or starting a project.</p>
      <p>Disclaimer: Sales figures and results stated above are my personal results and those of my clients. Please understand my results are not typical. I'm not implying you'll duplicate them (or do anything for that matter). The average person who buys any "how to" information gets little to no results. I'm using these references for example purposes only. Your results will vary and depend on many factors including but not limited to your background, experience, and work ethic. All business entails risk as well as massive and consistent effort and action. If you're not willing to accept that, please DO NOT submit your information.</p>
      <p>This site is not a part of the Facebook website or Facebook Inc. Additionally, this site is NOT endorsed by Facebook in any way. FACEBOOK is a trademark of FACEBOOK, Inc.</p>
      <p>This site is not a part of Google, LLC or any Google properties. This site is NOT endorsed by Google in any way. GOOGLE is a trademark of GOOGLE, LLC.</p>
      <p>We are not an affiliate network and we do not sell or participate in buying leads. We build custom local SEO website engines directly for service-based businesses.</p>
    </div>
    <div class="flex flex-col items-center gap-2">
      <div class="flex space-x-4">
        <a href="https://contractorhub.homeprosohio.com/privacy-policy" target="_blank" rel="noopener noreferrer" class="hover:text-white">Privacy Policy</a>
        <a href="https://contractorhub.homeprosohio.com/terms-of-service" target="_blank" rel="noopener noreferrer" class="hover:text-white">Terms of Service</a>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </div>
      <p>© {year} Jonathan Blake LLC DBA {business.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
