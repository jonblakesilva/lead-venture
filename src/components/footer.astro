---
import { business } from "@/config/business";
import { getCollection } from "astro:content";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const locations = (await getCollection("locations", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const year = new Date().getFullYear();

const companyLinks = [
  { title: "About Us",      path: "/about" },
  { title: "Services",      path: "/services" },
  { title: "Service Areas", path: "/service-areas" },
  { title: "Pricing",       path: "/pricing" },
  { title: "Blog",          path: "/blog" },
  { title: "Contact",       path: "/contact" },
];
---

<footer class="bg-primary-900 text-white">
  <!-- Main footer -->
  <div class="max-w-(--breakpoint-xl) mx-auto px-5 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Col 1: Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block">
          <span class="font-heading font-bold text-2xl text-white">{business.name}</span>
        </a>
        <p class="text-white/60 text-sm leading-relaxed mt-3 max-w-xs">
          {business.tagline}
        </p>

        <!-- Contact info -->
        <div class="mt-6 space-y-2">
          <a
            href={`tel:${business.phoneRaw}`}
            class="flex items-center gap-2 text-white/80 hover:text-accent-300 text-sm transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-accent-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
            </svg>
            {business.phone}
          </a>
          <a
            href={`mailto:${business.email}`}
            class="flex items-center gap-2 text-white/80 hover:text-accent-300 text-sm transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {business.email}
          </a>
          <div class="flex items-start gap-2 text-white/60 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {business.city}, {business.state} {business.zip}<br/>
            <span class="text-white/40 text-xs">{business.serviceRadius}</span>
          </div>
        </div>

        <!-- Social links -->
        {(business.socials.facebook || business.socials.instagram) && (
          <div class="flex gap-3 mt-6">
            {business.socials.facebook && (
              <a href={business.socials.facebook} target="_blank" rel="noopener noreferrer"
                class="w-8 h-8 bg-white/10 hover:bg-accent-500 rounded-lg flex items-center justify-center transition-colors"
                aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
                </svg>
              </a>
            )}
            {business.socials.instagram && (
              <a href={business.socials.instagram} target="_blank" rel="noopener noreferrer"
                class="w-8 h-8 bg-white/10 hover:bg-accent-500 rounded-lg flex items-center justify-center transition-colors"
                aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Col 2: Company links -->
      <div>
        <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-white/40 mb-5">Company</h3>
        <ul class="space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.path} class="text-white/70 hover:text-white text-sm transition-colors">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-white/40 mb-5">Services</h3>
        <ul class="space-y-2.5">
          {services.map((service) => (
            <li>
              <a href={`/services/${service.data.urlSlug}`} class="text-white/70 hover:text-white text-sm transition-colors">
                {service.data.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-accent-400 hover:text-accent-300 text-sm transition-colors font-medium">
              All Services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Service Areas -->
      <div>
        <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-white/40 mb-5">Service Areas</h3>
        <ul class="space-y-2.5">
          {locations.map((location) => (
            <li>
              <a href={`/service-areas/${location.data.urlSlug}`} class="text-white/70 hover:text-white text-sm transition-colors">
                {location.data.city}, {location.data.state}
              </a>
            </li>
          ))}
          <li>
            <a href="/service-areas" class="text-accent-400 hover:text-accent-300 text-sm transition-colors font-medium">
              All Areas →
            </a>
          </li>
        </ul>

        <!-- License badge -->
        {business.licenseNumber && (
          <div class="mt-8 p-3 bg-white/5 rounded-lg border border-white/10">
            <p class="text-white/40 text-xs">Licensed & Insured</p>
            <p class="text-white/70 text-xs font-mono mt-0.5">Lic # {business.licenseNumber}</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-white/40 text-xs">
        © {year} {business.name}. All rights reserved.
      </p>
      <div class="flex gap-5">
        <a href="/privacy" class="text-white/40 hover:text-white/70 text-xs transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-white/40 hover:text-white/70 text-xs transition-colors">Terms of Service</a>
        <a href="/sitemap-index.xml" class="text-white/40 hover:text-white/70 text-xs transition-colors">Sitemap</a>
      </div>
      <a href="https://theleadventure.com" target="_blank" rel="noopener noreferrer" class="text-white/30 hover:text-white/60 text-xs transition-colors">
        Built by The Lead Venture
      </a>
    </div>
  </div>
</footer>
