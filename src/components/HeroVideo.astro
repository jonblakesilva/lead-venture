---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="mx-auto mb-8 flex w-full max-w-4xl flex-col items-center">
  <div id="video-toggle" class="mb-4 rounded-full border border-primary/40 bg-primary/10 px-6 py-2 text-lg font-bold text-primary shadow-lg backdrop-blur-sm transition-all duration-300 md:text-xl">
    Turn Your Sound On 🔊
  </div>

  <div class="group relative aspect-video w-full overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
    <video
      id="hero-video"
      class="h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      controls={false}
    >
      <source src={src} type="video/mp4" />
      Your browser does not support the video tag.
    </video>

    <button
      id="play-overlay"
      type="button"
      class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors hover:bg-black/30"
      aria-label="Play video"
    >
      <div class="flex h-20 w-20 items-center justify-center rounded-full border border-white/20 bg-black/60 text-white shadow-xl transition-transform group-hover:scale-110">
        <svg viewBox="0 0 24 24" class="ml-1 h-10 w-10 fill-current" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    </button>
  </div>
</div>

<script>
  const video = document.getElementById('hero-video');
  const toggle = document.getElementById('video-toggle');
  const overlay = document.getElementById('play-overlay');

  if (video && toggle && overlay) {
    const handlePlay = () => {
      video.muted = false;
      video.controls = true;
      toggle.classList.add('opacity-0', 'h-0', 'overflow-hidden', 'mb-0');
      toggle.classList.remove('mb-4', 'opacity-100');
      overlay.style.display = 'none';
    };

    overlay.addEventListener('click', () => {
      video.play();
      handlePlay();
    });

    video.addEventListener('play', () => {
      handlePlay();
    });

    video.addEventListener('pause', () => {
      toggle.classList.remove('opacity-0', 'h-0', 'overflow-hidden', 'mb-0');
      toggle.classList.add('mb-4', 'opacity-100');
      overlay.style.display = 'flex';
    });
  }
</script>
