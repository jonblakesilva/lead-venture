---
import { business } from "@/config/business";
---

<!-- Exit popup — fires once per session, 25 seconds after page load -->
<div
  id="exit-popup-overlay"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <div
    class="relative bg-white rounded-2xl shadow-2xl max-w-sm w-full p-7 text-center"
    style="animation: scaleIn 0.25s ease both;"
  >
    <!-- Close button -->
    <button
      id="exit-popup-close"
      aria-label="Close"
      class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center text-neutral-400 hover:text-neutral-700 hover:bg-neutral-100 rounded-full transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Icon -->
    <div class="w-14 h-14 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
    </div>

    <h2 id="exit-popup-title" class="font-heading text-2xl font-bold text-primary-900 mb-2">
      Get Your Free Estimate
    </h2>
    <p class="text-neutral-500 text-sm mb-6 leading-relaxed">
      Ready to get started? Reach out now — we respond fast and all estimates are 100% free with no obligation.
    </p>

    <div class="flex flex-col gap-3">

      <!-- Call -->
      <a
        href={`tel:${business.phoneRaw}`}
        class="flex items-center justify-center gap-2.5 w-full bg-primary-900 hover:bg-primary-800 text-white font-bold py-3.5 rounded-xl transition-colors text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
        </svg>
        Call {business.phone}
      </a>

      <!-- Text -->
      <a
        href={`sms:+1${business.phoneRaw}`}
        class="flex items-center justify-center gap-2.5 w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3.5 rounded-xl transition-colors text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-3 3-3-3z"/>
        </svg>
        Text {business.phone}
      </a>

      <!-- Quote -->
      <a
        href="/contact"
        class="flex items-center justify-center gap-2.5 w-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-3.5 rounded-xl transition-colors text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Get a Free Quote Online
      </a>

    </div>

    <button
      id="exit-popup-dismiss"
      class="mt-5 text-xs text-neutral-400 hover:text-neutral-600 transition-colors"
    >
      No thanks, I'll keep browsing
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var SESSION_KEY = "exit_popup_shown";
    if (sessionStorage.getItem(SESSION_KEY)) return;

    var overlay = document.getElementById("exit-popup-overlay");
    if (!overlay) return;

    var shown = false;
    var timerElapsed = false;

    function showPopup() {
      if (shown) return;
      shown = true;
      sessionStorage.setItem(SESSION_KEY, "1");
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function hidePopup() {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
    }

    // Show 25 seconds after page load
    setTimeout(function () {
      timerElapsed = true;
      showPopup();
    }, 25000);

    // Exit intent on desktop — only fires after the 25s timer has elapsed
    function onMouseLeave(e) {
      if (timerElapsed && e.clientY <= 0) {
        showPopup();
        document.removeEventListener("mouseleave", onMouseLeave);
      }
    }
    document.addEventListener("mouseleave", onMouseLeave);

    // Close handlers
    var closeBtn = document.getElementById("exit-popup-close");
    var dismissBtn = document.getElementById("exit-popup-dismiss");
    if (closeBtn) closeBtn.addEventListener("click", hidePopup);
    if (dismissBtn) dismissBtn.addEventListener("click", hidePopup);

    // Click outside the card to close
    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) hidePopup();
    });

    // Escape key
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") hidePopup();
    });
  })();
</script>
