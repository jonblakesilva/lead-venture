---
---

<!-- Exit intent popup — fires once per session, 30s after page load (instantly on /pricing) -->
<div
  id="exit-popup-overlay"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
  data-pricing={Astro.url.pathname === "/pricing" ? "true" : "false"}
>
  <div class="relative w-full max-w-sm rounded-2xl bg-white p-7 text-center shadow-2xl" style="animation: scaleIn 0.25s ease both;">
    <button
      id="exit-popup-close"
      aria-label="Close"
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <h2 id="exit-popup-title" class="mb-2 font-heading text-2xl font-bold text-primary-900">
      Wait! Don't Leave Empty-Handed.
    </h2>
    <p class="mb-6 text-sm leading-relaxed text-neutral-500">
      Before you go, grab a free <strong>$50k Revenue Recovery Audit</strong>. We'll show you exactly where your business is leaking revenue and how to fix it — no strings attached.
    </p>

    <div class="flex flex-col gap-3">
      <a
        href="https://links.theleadventure.com/widget/booking/C2VL0S6llGMFg5aY5whk"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full rounded-xl bg-accent-500 py-3.5 text-sm font-bold text-white transition-colors hover:bg-accent-600"
      >
        Get My Free Growth Audit
      </a>
      <button id="exit-popup-dismiss" class="mt-1 text-xs text-neutral-400 transition-colors hover:text-neutral-600">
        No thanks, I'll pass
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById("exit-popup-overlay");
    if (!overlay) return;

    var isPricing = overlay.dataset.pricing === "true";
    var sessionKey = isPricing ? "pricingExitIntentShown" : "globalExitIntentShown";
    if (sessionStorage.getItem(sessionKey)) return;

    var shown = false;
    var ready = isPricing;

    function showPopup() {
      if (shown) return;
      shown = true;
      sessionStorage.setItem(sessionKey, "true");
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function hidePopup() {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
    }

    if (!isPricing) {
      setTimeout(function () {
        ready = true;
      }, 30000);
    }

    function onMouseLeave(e) {
      if (ready && e.clientY <= 0) {
        showPopup();
        document.removeEventListener("mouseleave", onMouseLeave);
      }
    }
    document.addEventListener("mouseleave", onMouseLeave);

    document.getElementById("exit-popup-close")?.addEventListener("click", hidePopup);
    document.getElementById("exit-popup-dismiss")?.addEventListener("click", hidePopup);
    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) hidePopup();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") hidePopup();
    });
  })();
</script>
