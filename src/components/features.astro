---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="py-20 lg:py-28 bg-white" id="services">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <!-- Section header -->
    <div class="max-w-2xl" data-aos="fade-up">
      <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">What We Do</p>
      <h2 class="font-heading text-4xl lg:text-5xl font-bold text-primary-900 leading-tight">
        Our Services
      </h2>
      <p class="text-neutral-500 text-lg mt-4 leading-relaxed">
        Professional {business.niche} services for homeowners and businesses in the {business.city} area.
        Every job comes with our {business.guaranteeText.toLowerCase()}.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-14">
      {services.map((service, i) => (
        <a
          href={`/services/${service.data.urlSlug}`}
          class="group relative flex flex-col p-7 bg-white border border-neutral-200 rounded-2xl hover:border-accent-300 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay={Math.min(i + 1, 6) * 100}
        >
          <!-- Icon -->
          {service.data.icon ? (
            <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
              <Icon name={service.data.icon} class="w-6 h-6" />
            </div>
          ) : (
            <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
          )}

          <h3 class="font-heading font-bold text-xl text-primary-900 mb-2 group-hover:text-accent-600 transition-colors">
            {service.data.title}
          </h3>
          <p class="text-neutral-500 text-sm leading-relaxed flex-1">
            {service.data.shortDesc}
          </p>

          <span class="inline-flex items-center gap-1 mt-5 text-sm font-semibold text-accent-600 group-hover:gap-2 transition-all">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>

          <!-- Hover accent bar -->
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-accent-500 rounded-b-2xl scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
        </a>
      ))}
    </div>

    <!-- View all link -->
    <div class="mt-10 text-center" data-aos="fade-up">
      <a
        href="/services"
        class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-accent-600 transition-colors"
      >
        View all services
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
