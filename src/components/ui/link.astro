---
interface Props {
  href: string;
  size?: "sm" | "md" | "lg";
  block?: boolean;
  style?: "primary" | "outline" | "inverted" | "muted" | "ghost";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-2.5 text-sm",
  lg: "px-6 py-3 text-base",
};

const styles = {
  primary:  "bg-accent-500 text-white hover:bg-accent-600 border-2 border-transparent shadow-sm",
  outline:  "bg-transparent border-2 border-primary-800 text-primary-800 hover:bg-primary-50",
  inverted: "bg-white text-primary-900 hover:bg-neutral-100 border-2 border-transparent shadow-sm",
  muted:    "bg-neutral-100 hover:bg-neutral-200 text-neutral-800 border-2 border-transparent",
  ghost:    "bg-transparent text-primary-700 hover:text-accent-600 border-2 border-transparent underline-offset-2 hover:underline",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center rounded-lg font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
>
  <slot />
</a>
