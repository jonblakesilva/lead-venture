<!-- Sticky mobile CTA — hidden on desktop, slides up after 20% scroll on mobile -->
<div
  id="mobile-call-bar"
  class="fixed bottom-0 left-0 right-0 z-40 flex translate-y-full items-center justify-between border-t border-white/10 bg-[#1A1D27] p-3 shadow-[0_-10px_20px_rgba(0,0,0,0.2)] transition-transform duration-300 lg:hidden"
>
  <div class="flex flex-col pl-2 font-bold leading-tight text-white">
    <span class="text-[15px]">Free $3K+ website.</span>
    <span class="text-[15px]">$0 down.</span>
  </div>
  <a href="/contact" class="flex shrink-0 flex-col items-center justify-center rounded-lg bg-accent-500 px-5 py-2 transition-colors hover:bg-accent-600">
    <span class="block text-[15px] font-bold leading-tight text-white">Claim my free build</span>
    <span class="mt-0.5 block text-[11px] font-semibold leading-tight text-white/80">Try free for 14 days</span>
  </a>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById("mobile-call-bar");
    if (!bar) return;

    function onScroll() {
      var threshold = document.documentElement.scrollHeight * 0.2;
      var past = window.scrollY > threshold && window.scrollY > 100;
      bar.classList.toggle("translate-y-full", !past);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
