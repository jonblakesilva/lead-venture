---
const steps = [
  {
    number: "01",
    title: "Request a Free Quote",
    description:
      "Call us or fill out our quick online form. We'll ask a few questions to understand your needs and get back to you fast — usually the same business day.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
  },
  {
    number: "02",
    title: "We Show Up On Time",
    description:
      "Our team arrives at the scheduled window, introduces themselves, and does a quick walk-through of the work before starting. No surprises, no upsells.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    number: "03",
    title: "Work Done Right — Guaranteed",
    description:
      "We complete the job to a high standard and clean up after ourselves. If anything isn't right, we come back and fix it free of charge. That's our promise.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
];
---

<section class="py-20 lg:py-28 bg-neutral-50">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <!-- Header -->
    <div class="max-w-2xl mx-auto text-center" data-aos="fade-up">
      <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">Simple Process</p>
      <h2 class="font-heading text-4xl lg:text-5xl font-bold text-primary-900">
        How It Works
      </h2>
      <p class="text-neutral-500 text-lg mt-4">
        Getting started is easy. Here's what happens when you reach out.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid md:grid-cols-3 gap-8 mt-16 relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden md:block absolute top-10 left-1/6 right-1/6 h-px bg-neutral-200 -z-0"></div>

      {steps.map((step, i) => (
        <div class="relative flex flex-col items-center text-center" data-aos="fade-up" data-aos-delay={(i + 1) * 100}>
          <!-- Number bubble -->
          <div class="relative z-10 w-20 h-20 rounded-2xl bg-primary-900 text-white flex flex-col items-center justify-center mb-6 shadow-lg">
            <div set:html={step.icon} class="opacity-60 w-7 h-7 absolute top-3 right-3 scale-50 origin-top-right" />
            <span class="font-heading font-bold text-3xl">{step.number}</span>
          </div>

          <h3 class="font-heading font-bold text-xl text-primary-900 mb-3">{step.title}</h3>
          <p class="text-neutral-500 leading-relaxed text-sm">{step.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center" data-aos="fade-up">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors shadow-sm text-base"
      >
        Start with a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
