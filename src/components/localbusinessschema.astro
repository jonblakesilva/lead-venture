---
import { business } from "@/config/business";

interface Props {
  areaServed?: string; // optional override, e.g. a specific city for location pages
}

const { areaServed } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  telephone: business.phone,
  email: business.email,
  areaServed: areaServed ?? `${business.city}, ${business.state} — ${business.serviceRadius}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: business.city,
    addressRegion: business.state,
    postalCode: business.zip,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: String(business.rating),
    reviewCount: String(business.reviewCount),
    bestRating: "5",
    worstRating: "1",
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
