---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const pillars = [
  {
    title: "Built by operators",
    copy: "We understood the pain of missed calls, bad follow-up, and ugly websites because we lived it. Every tactic is built for real trade businesses, not generic marketing theory.",
  },
  {
    title: "No fluff. No bloated retainers.",
    copy: "We keep the system simple, transparent, and focused on the metric that matters most: booked work. You pay for growth support, not a bunch of vanity dashboards.",
  },
  {
    title: "Everything under one roof",
    copy: "Website, reviews, AI lead handling, messaging, and local SEO are connected so your funnel works together instead of being stitched together with random tools.",
  },
];
---

<Layout title="About The Lead Venture" description={`Learn how ${business.name} helps contractors win more leads, improve reviews, and run a healthier local service business.`}>
  <section class="bg-[#1A1D27] py-16 text-white md:py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">About</p>
        <h1 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-6xl">
          Built for contractors who want a business that runs like a pro.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
          {business.name} helps home-service businesses attract better leads, respond faster, and turn more of those opportunities into booked jobs. We do it with a simple system: conversion-focused web presence, review generation, and AI-powered follow-up that never misses a lead.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">Our story</p>
          <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">
            The problem we fixed was simple: most contractors are getting buried by poor follow-up.
          </h2>
          <div class="mt-6 space-y-4 text-lg leading-relaxed text-slate-600">
            <p>Marketing agencies talk in vanity metrics while your phone keeps ringing and your team keeps missing opportunities. We built a different approach around the real bottlenecks that kill growth: slow responses, weak review flow, outdated websites, and no follow-up system after the first inquiry hits.</p>
            <p>Today, we build simple, high-converting systems specifically for service businesses ? so owners can stop chasing leads and get back to running the company.</p>
          </div>
        </div>

        <div class="rounded-[28px] border border-slate-200 bg-[#f5f7fb] p-8 shadow-sm">
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="font-heading text-4xl font-black text-accent-500">{business.stats.jobsCompleted}+</div>
              <div class="mt-2 text-sm text-slate-600">Jobs completed</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="font-heading text-4xl font-black text-accent-500">{business.stats.yearsInBusiness}+</div>
              <div class="mt-2 text-sm text-slate-600">Years in business</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="font-heading text-4xl font-black text-accent-500">{business.rating}</div>
              <div class="mt-2 text-sm text-slate-600">Average rating</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="font-heading text-4xl font-black text-accent-500">{business.stats.satisfactionRate}%</div>
              <div class="mt-2 text-sm text-slate-600">Satisfaction</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f6f7f9] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">Why it works</p>
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">
          A simple system built around the way real contractors actually sell.
        </h2>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="rounded-[28px] border border-slate-200 bg-white p-7 shadow-sm">
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent-100 text-lg font-bold text-accent-700">?</div>
            <h3 class="text-2xl font-bold text-primary-900">{pillar.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-slate-600">{pillar.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#1A1D27] py-20 text-white">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5 text-center">
      <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-5xl">Serving {business.city}, {business.state} and surrounding areas.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/75">
        We help contractors in the region scale their marketing, uplift their review process, and build a system that keeps new opportunities coming in without burning out the team.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-accent-500 px-8 text-base font-semibold text-white transition hover:bg-accent-600">Book a Call</a>
      </div>
    </div>
  </section>
</Layout>
