---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import LocalBusinessSchema from "@/components/localbusinessschema.astro";
import ServiceSchema from "@/components/serviceschema.astro";
import FaqAccordion from "@/components/faqaccordion.astro";
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

export async function getStaticPaths() {
  const services = await getCollection("services", ({ data }) => !data.draft);
  return services.map((service) => ({
    params: { slug: service.data.urlSlug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

// All other services for the "also available" sidebar
const allServices = (await getCollection("services", ({ data }) => !data.draft))
  .filter((s) => s.data.urlSlug !== service.data.urlSlug)
  .sort((a, b) => a.data.order - b.data.order);

const faqItems = [
  {
    question: `How much does ${service.data.title.toLowerCase()} cost?`,
    answer: `Pricing depends on the scope of the job and your specific needs. We provide free, no-obligation estimates — call us at ${business.phone} or fill out the form below for a fast quote.`,
  },
  {
    question: "Do you serve my area?",
    answer: `We serve ${business.city}, ${business.state} and the surrounding area within a ${business.serviceRadius}. Contact us to confirm we cover your address.`,
  },
  {
    question: `Is ${service.data.title.toLowerCase()} available as a one-time service?`,
    answer: "Yes — we offer both one-time and recurring options. Let us know what you're looking for when you request a quote.",
  },
  {
    question: "How quickly can I schedule service?",
    answer: `We typically schedule within 1–3 business days. For urgent needs, call us at ${business.phone} and we'll do our best to accommodate you sooner.`,
  },
  {
    question: "Is your work guaranteed?",
    answer: `Yes. ${business.guaranteeText}. If you're not satisfied with the results, contact us and we'll make it right.`,
  },
];
---

<Layout
  title={service.data.title}
  description={`${service.data.shortDesc} ${business.name} serves ${business.city}, ${business.state} and surrounding areas. Free estimates — call ${business.phone}.`}
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    <ServiceSchema
      serviceName={service.data.title}
      serviceDescription={service.data.shortDesc}
    />
  </Fragment>

  <!-- Page header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <nav class="text-sm text-white/50 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span>›</span>
        <span class="text-white/80">{service.data.title}</span>
      </nav>

      <div class="flex items-start gap-5">
        {service.data.icon && (
          <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center shrink-0">
            <Icon name={service.data.icon} class="w-7 h-7 text-accent-300" />
          </div>
        )}
        <div>
          <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
            {service.data.title}
          </h1>
          <p class="text-white/70 text-lg mt-3 max-w-2xl">{service.data.shortDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service hero image -->
  {service.data.image?.src && (
    <div class="w-full h-56 md:h-72 lg:h-80 overflow-hidden">
      <img
        src={service.data.image.src}
        alt={service.data.image.alt}
        class="w-full h-full object-cover"
        width="1200"
        height="500"
        loading="eager"
        decoding="sync"
      />
    </div>
  )}

  <div class="max-w-(--breakpoint-xl) mx-auto px-5 py-16">
    <div class="grid lg:grid-cols-3 gap-12">

      <!-- Main content -->
      <div class="lg:col-span-2">
        <div class="prose prose-neutral max-w-none prose-headings:font-heading prose-headings:text-primary-900 prose-a:text-accent-600">
          <Content />
        </div>

        <!-- FAQ -->
        <div class="mt-16">
          <h2 class="font-heading text-3xl font-bold text-primary-900 mb-8">
            Frequently Asked Questions
          </h2>
          <FaqAccordion items={faqItems} />
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">

        <!-- CTA card -->
        <div class="bg-primary-900 text-white rounded-2xl p-7 sticky top-24">
          <h3 class="font-heading font-bold text-xl text-white mb-2">Get a Free Quote</h3>
          <p class="text-white/70 text-sm mb-6 leading-relaxed">
            Call us or fill out the contact form for a fast, no-obligation estimate on {service.data.title.toLowerCase()}.
          </p>

          <a
            href={`tel:${business.phoneRaw}`}
            class="flex items-center justify-center gap-2 w-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-3.5 rounded-xl transition-colors text-base mb-3"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
            </svg>
            {business.phone}
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center w-full border-2 border-white/30 hover:border-white/60 text-white font-semibold py-3 rounded-xl transition-colors text-sm"
          >
            Request Online →
          </a>

          <div class="mt-6 pt-6 border-t border-white/10 space-y-2">
            {[
              "Free estimates",
              "Licensed & insured",
              business.guaranteeText,
            ].map((item) => (
              <div class="flex items-center gap-2 text-xs text-white/70">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </div>
            ))}
          </div>
        </div>

        <!-- Other services -->
        {allServices.length > 0 && (
          <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-6">
            <h3 class="font-semibold text-primary-900 text-sm uppercase tracking-wide mb-4">Also Available</h3>
            <ul class="space-y-2">
              {allServices.map((s) => (
                <li>
                  <a
                    href={`/services/${s.data.urlSlug}`}
                    class="flex items-center gap-2.5 text-sm text-neutral-700 hover:text-accent-600 transition-colors py-1"
                  >
                    {s.data.icon && <Icon name={s.data.icon} class="w-4 h-4 text-neutral-400" />}
                    {s.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>
