---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";
import Cta from "@/components/cta.astro";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Services"
  description={`${business.niche} services by ${business.name} — serving ${business.city}, ${business.state} and surrounding areas. Free estimates available.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">What We Offer</p>
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">Our Services</h1>
      <p class="text-white/70 text-lg mt-4 max-w-2xl">
        Professional {business.niche} services for homeowners and businesses in {business.city} and surrounding areas.
        Every job backed by our {business.guaranteeText.toLowerCase()}.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {services.map((service, i) => (
          <a
            href={`/services/${service.data.urlSlug}`}
            class="group flex flex-col bg-white border-2 border-neutral-200 rounded-2xl p-7 hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={Math.min(i + 1, 6) * 100}
          >
            {service.data.icon ? (
              <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
                <Icon name={service.data.icon} class="w-6 h-6" />
              </div>
            ) : null}

            <h2 class="font-heading font-bold text-xl text-primary-900 mb-3 group-hover:text-accent-600 transition-colors">
              {service.data.title}
            </h2>
            <p class="text-neutral-500 text-sm leading-relaxed flex-1">{service.data.shortDesc}</p>

            <span class="inline-flex items-center gap-1 mt-6 text-sm font-semibold text-accent-600 group-hover:gap-2 transition-all">
              Learn more
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Bottom CTA strip -->
      <div class="bg-primary-900 text-white rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6" data-aos="fade-up">
        <div>
          <h2 class="font-heading font-bold text-xl">Not sure which service you need?</h2>
          <p class="text-white/60 text-sm mt-1">Call us and we'll help you figure out the right solution.</p>
        </div>
        <div class="flex gap-3 shrink-0">
          <a
            href={`tel:${business.phoneRaw}`}
            class="bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 py-3 rounded-xl transition-colors text-sm whitespace-nowrap"
          >
            Call {business.phone}
          </a>
          <a
            href="/contact"
            class="border-2 border-white/30 hover:border-white text-white font-semibold px-6 py-3 rounded-xl transition-colors text-sm"
          >
            Get a Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Layout>
