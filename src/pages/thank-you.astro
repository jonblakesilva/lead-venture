---
import Layout from "@/layouts/Layout.astro";
import ReviewCta from "@/components/reviewcta.astro";
import { business } from "@/config/business";
---

<Layout
  title="Thank You"
  description={`Thank you for contacting ${business.name}. We'll be in touch shortly.`}
>
  <section class="min-h-screen bg-neutral-50 flex items-center justify-center py-20 px-5">
    <div class="max-w-lg w-full text-center animate-scale-in">
      <!-- Success icon -->
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <h1 class="font-heading text-4xl font-bold text-primary-900 mb-4">
        Message Received!
      </h1>
      <p class="text-neutral-600 text-lg leading-relaxed mb-8">
        Thank you for contacting {business.name}. We've received your request and will
        get back to you within one business day — usually much sooner.
      </p>

      <!-- What happens next -->
      <div class="bg-white border border-neutral-200 rounded-2xl p-7 text-left mb-8">
        <h2 class="font-semibold text-primary-900 text-base mb-4">What happens next:</h2>
        <ol class="space-y-3">
          {[
            "We'll review your request and reach out by phone or email.",
            "We'll schedule a time to provide your free, no-obligation estimate.",
            "You'll receive a clear, itemized quote — no hidden fees.",
          ].map((step, i) => (
            <li class="flex items-start gap-3 text-sm text-neutral-600">
              <span class="w-6 h-6 bg-primary-900 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">
                {i + 1}
              </span>
              {step}
            </li>
          ))}
        </ol>
      </div>

      <!-- Need faster? Call directly -->
      <div class="bg-accent-50 border border-accent-200 rounded-2xl p-6 mb-8">
        <p class="text-sm text-neutral-700 font-medium mb-2">Need a faster response?</p>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center gap-2 text-accent-700 font-bold text-lg hover:text-accent-800 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          Call {business.phone}
        </a>
      </div>

      <ReviewCta />

      <a
        href="/"
        class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-accent-600 transition-colors text-sm mt-6 block"
      >
        ← Back to Home
      </a>
    </div>
  </section>
</Layout>
