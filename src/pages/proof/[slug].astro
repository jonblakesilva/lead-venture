---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { business } from "@/config/business";

export async function getStaticPaths() {
  const caseStudies = await getCollection("case-studies", ({ data }) => !data.draft);
  return caseStudies.map((study) => ({
    params: { slug: study.data.urlSlug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);

const otherStudies = (await getCollection("case-studies", ({ data }) => !data.draft))
  .filter((s) => s.data.urlSlug !== study.data.urlSlug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title={study.data.title} description={study.data.excerpt}>
  <section class="border-b border-white/10 bg-[#1A1D27] py-20 text-white md:py-28">
    <div class="mx-auto max-w-4xl px-5">
      <nav class="mb-6 flex items-center gap-2 text-sm text-white/50">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>›</span>
        <a href="/proof/case-studies" class="transition-colors hover:text-white">Case Studies</a>
      </nav>
      <div class="mb-6 inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm font-medium text-white/80">
        <span class="mr-2 h-2 w-2 rounded-full bg-accent-400"></span>
        {study.data.badge}
      </div>
      <h1 class="font-heading text-4xl font-bold leading-[1.1] tracking-tight md:text-6xl">{study.data.title}</h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-white/80">{study.data.excerpt}</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-5">
      {study.data.image && (
        <img
          src={study.data.image}
          alt={study.data.title}
          loading="lazy"
          class="mx-auto mb-12 max-h-[500px] rounded-2xl border border-neutral-200 object-contain shadow-lg"
        />
      )}
      <div class="prose prose-neutral max-w-none prose-headings:font-heading prose-headings:text-primary-900 prose-a:text-accent-600 prose-table:text-sm prose-blockquote:border-accent-400 prose-blockquote:text-primary-900 prose-blockquote:font-medium">
        <Content />
      </div>
    </div>
  </section>

  <TestimonialCarousel />

  {otherStudies.length > 0 && (
    <section class="border-t border-neutral-200 bg-neutral-50 py-20">
      <div class="mx-auto max-w-(--breakpoint-xl) px-5">
        <h2 class="mb-10 text-center font-heading text-3xl font-bold text-primary-900">More Case Studies</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {otherStudies.map((s) => (
            <a href={`/proof/${s.data.urlSlug}`} class="group rounded-3xl border border-neutral-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <div class="mb-3 inline-flex items-center rounded-full border border-accent-200 bg-accent-50 px-3 py-1 text-xs font-semibold text-accent-700">{s.data.badge}</div>
              <h3 class="text-lg font-bold text-primary-900 line-clamp-2">{s.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600 line-clamp-3">{s.data.excerpt}</p>
              <div class="mt-5 text-sm font-semibold text-accent-600">Read case study →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-[#1A1D27] py-24 text-center text-white">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-heading text-3xl font-bold md:text-5xl">Want Results Like This?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-xl text-white/80">
        Stop losing jobs to competitors with faster sites and more reviews. Let us build your growth engine.
      </p>
      <a href="/contact" class="mt-10 inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">
        Request a Website & SEO Review
      </a>
    </div>
  </section>
</Layout>
