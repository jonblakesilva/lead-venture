---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

// ─── CUSTOMIZE THIS ESTIMATOR ────────────────────────────────────────────────
// This estimator is set up for services that are priced per job size.
// If your niche prices differently (per hour, per unit, etc.),
// adapt the inputs and calculation logic below.
//
// Option A: Per-size pricing (current setup — works for cleaning, landscaping, etc.)
// Option B: Per-unit pricing (roofing by sq ft, painting by room, etc.)
// Option C: Project-type pricing (HVAC by system type, plumbing by job type, etc.)
// ─────────────────────────────────────────────────────────────────────────────
---

<Layout
  title="Free Cost Estimator"
  description={`Instant ballpark estimate for ${business.niche} services in ${business.city}, ${business.state}. Get an exact quote by calling ${business.phone}.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-16">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Free Tool</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Instant Cost Estimator
        </h1>
        <p class="text-white/70 text-lg mt-4">
          Get a ballpark price in seconds. This is a rough estimate — for an exact quote, just call or fill out the form.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-12 items-start max-w-4xl mx-auto">

        <!-- Estimator tool -->
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 shadow-[var(--shadow-card)]">
          <h2 class="font-heading font-bold text-xl text-primary-900 mb-6">Estimate Your Project</h2>

          <div class="space-y-6" id="estimator">

            <!-- Input 1: Job size / scope -->
            <div>
              <label for="jobSize" class="block text-sm font-medium text-neutral-700 mb-2">
                <!-- CUSTOMIZE: Change this label to match your service.
                     Examples: "Square footage", "Number of rooms", "System type" -->
                Approximate size (sq ft)
              </label>
              <input
                type="range"
                id="jobSize"
                min="500"
                max="10000"
                step="250"
                value="2500"
                class="w-full accent-accent-500"
              />
              <div class="flex justify-between text-xs text-neutral-400 mt-1">
                <span>Small (500 sq ft)</span>
                <span id="jobSizeValue" class="font-semibold text-neutral-900 text-sm">2,500 sq ft</span>
                <span>Large (10,000 sq ft)</span>
              </div>
            </div>

            <!-- Input 2: Service tier / frequency -->
            <div>
              <label for="serviceType" class="block text-sm font-medium text-neutral-700 mb-2">
                <!-- CUSTOMIZE: Change this label and options to match your service.
                     Examples: service frequency, project type, material grade -->
                Service type
              </label>
              <select
                id="serviceType"
                class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-neutral-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 focus:outline-none bg-white text-sm"
              >
                <!-- CUSTOMIZE: Replace these with your actual service tiers or types -->
                <option value="standard" selected>Standard service</option>
                <option value="premium">Premium / deep service</option>
                <option value="onetime">One-time service</option>
              </select>
            </div>

            <!-- Output -->
            <div class="bg-neutral-50 rounded-xl p-6 border border-neutral-200">
              <p class="text-sm text-neutral-500 mb-1">Estimated price range</p>
              <p id="estimateOutput" class="font-heading font-bold text-4xl text-primary-900">$--- - $---</p>
              <p class="text-xs text-neutral-400 mt-2">
                This is a rough estimate only. Actual pricing depends on specific conditions, access, and your exact requirements.
              </p>
            </div>

            <a
              href="/contact"
              class="block w-full text-center bg-accent-500 hover:bg-accent-600 text-white font-bold py-4 rounded-xl transition-colors"
            >
              Get an Exact Quote — Free
            </a>
          </div>
        </div>

        <!-- Supporting info -->
        <div class="space-y-6">
          <div>
            <h2 class="font-heading font-bold text-2xl text-primary-900 mb-3">
              How We Price Our Services
            </h2>
            <p class="text-neutral-600 leading-relaxed text-sm">
              <!-- CUSTOMIZE: Explain how your pricing actually works so customers trust the estimate. -->
              Our pricing depends on [key factors that affect your pricing — e.g. "the size of the job, the condition
              of the property, and the specific service selected"]. The estimator above gives you a starting range,
              but every job is a little different.
            </p>
          </div>

          <div class="space-y-4">
            {[
              {
                title: "Free, no-obligation quotes",
                desc: "Our estimates are always free and there's no pressure to book.",
              },
              {
                title: "Upfront pricing — always",
                desc: "We tell you the exact price before we start. No surprises at the end.",
              },
              {
                title: "Price match guarantee",
                desc: "Found a lower price for the same service? Let us know and we'll match it. <!-- CUSTOMIZE or remove -->",
              },
            ].map((item) => (
              <div class="flex gap-3">
                <div class="w-8 h-8 bg-accent-100 text-accent-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-primary-900 text-sm">{item.title}</div>
                  <div class="text-neutral-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-primary-900 text-white rounded-xl p-6">
            <p class="font-semibold text-sm mb-2">Want a real number? Call us:</p>
            <a
              href={`tel:${business.phoneRaw}`}
              class="text-accent-300 hover:text-accent-200 font-bold text-xl transition-colors"
            >
              {business.phone}
            </a>
            <p class="text-white/50 text-xs mt-1">Mon–Sat 7am–7pm</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  // ─── CUSTOMIZE PRICING LOGIC ─────────────────────────────────────────────
  // Adjust these rates to reflect your actual pricing ranges.
  // BASE_RATE is dollars per unit (e.g. per 1,000 sq ft, per room, etc.)
  // SERVICE_MULTIPLIERS adjust the base rate for different service types.
  // ─────────────────────────────────────────────────────────────────────────

  const BASE_RATE_PER_1000 = 12; // CUSTOMIZE: dollars per 1,000 sq ft (or per unit)
  const SERVICE_MULTIPLIERS: Record<string, number> = {
    standard: 1.0,
    premium:  1.5,
    onetime:  1.8,
  };

  const jobSizeInput    = document.getElementById("jobSize") as HTMLInputElement;
  const jobSizeValue    = document.getElementById("jobSizeValue") as HTMLSpanElement;
  const serviceSelect   = document.getElementById("serviceType") as HTMLSelectElement;
  const estimateOutput  = document.getElementById("estimateOutput") as HTMLParagraphElement;

  function calculate() {
    const size       = parseInt(jobSizeInput.value, 10);
    const multiplier = SERVICE_MULTIPLIERS[serviceSelect.value] ?? 1;

    jobSizeValue.textContent = `${size.toLocaleString()} sq ft`;

    const base = (size / 1000) * BASE_RATE_PER_1000 * multiplier;
    const low  = Math.round((base * 0.85) / 5) * 5;
    const high = Math.round((base * 1.20) / 5) * 5;

    estimateOutput.textContent = `$${low.toLocaleString()} – $${high.toLocaleString()}`;
  }

  jobSizeInput.addEventListener("input", calculate);
  serviceSelect.addEventListener("change", calculate);
  calculate();
</script>
