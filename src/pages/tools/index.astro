---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

// CUSTOMIZE: Add more calculators here as you build them.
// Each tool needs: title, desc, href, and an icon SVG string.
const tools = [
  {
    title: "Cost Estimator",
    desc: `Get an instant ballpark price for ${business.niche} services based on your job size and scope.`,
    href: "/tools/cost-estimator",
    badge: "Most Used",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
  },
  {
    title: "Project Timeline Estimator",
    desc: "Find out how long your project will take based on job type, crew size, and complexity.",
    href: "/tools/timeline-estimator",
    badge: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
  },
  {
    title: "Recurring vs. One-Time Savings",
    desc: "Compare the cost of recurring maintenance versus one-time reactive service over 12 months.",
    href: "/tools/savings-calculator",
    badge: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
];
---

<Layout
  title="Free Tools & Calculators"
  description={`Free tools to help you plan and budget your ${business.niche} project in ${business.city}, ${business.state}. Cost estimators, timelines, and savings calculators.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Free Tools</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Calculators & Estimators
        </h1>
        <p class="text-white/70 text-lg mt-4 leading-relaxed">
          Free tools to help you plan your {business.niche.toLowerCase()} project, understand costs,
          and make smarter decisions — no sign-up required.
        </p>
      </div>
    </div>
  </section>

  <!-- Tools grid -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {tools.map((tool, i) => (
          <a
            href={tool.href}
            class="relative group bg-white rounded-2xl border-2 border-neutral-200 hover:border-accent-400 p-7 flex flex-col shadow-sm hover:shadow-md transition-all duration-200"
            data-aos="fade-up"
            data-aos-delay={(i + 1) * 100}
          >
            {tool.badge && (
              <span class="absolute top-4 right-4 bg-accent-500 text-white text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full">
                {tool.badge}
              </span>
            )}

            <div class="w-14 h-14 bg-primary-100 text-primary-700 rounded-2xl flex items-center justify-center mb-5 group-hover:bg-primary-900 group-hover:text-white transition-colors duration-200"
              set:html={tool.icon} />

            <h2 class="font-heading font-bold text-lg text-primary-900 mb-2 group-hover:text-accent-600 transition-colors">
              {tool.title}
            </h2>
            <p class="text-neutral-500 text-sm leading-relaxed flex-1">{tool.desc}</p>

            <div class="flex items-center gap-1.5 text-accent-600 font-semibold text-sm mt-5">
              Open Tool
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Bottom info -->
      <div class="text-center mt-14" data-aos="fade-up">
        <p class="text-neutral-500 text-sm max-w-lg mx-auto">
          These tools give you a starting point. For a firm quote tailored to your exact property,
          call us or fill out the contact form.
        </p>
        <div class="flex flex-wrap gap-4 justify-center mt-6">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 py-3.5 rounded-xl transition-colors shadow-md text-sm"
          >
            Get an Exact Quote — Free
          </a>
          <a
            href={`tel:${business.phoneRaw}`}
            class="inline-flex items-center gap-2 border-2 border-primary-800 text-primary-800 hover:bg-primary-50 font-semibold px-7 py-3.5 rounded-xl transition-colors text-sm"
          >
            Call {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
