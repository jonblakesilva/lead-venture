---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";
---

<Layout
  title="Recurring vs. One-Time Savings Calculator"
  description={`See how much recurring ${business.niche} service saves vs. one-time reactive calls. Free calculator from ${business.name}.`}
>
  <section class="bg-primary-900 text-white py-16">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Free Tool</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Recurring vs. One-Time Savings
        </h1>
        <p class="text-white/70 text-lg mt-4">
          Compare the real cost of scheduled maintenance versus reactive, emergency service calls over a full year.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-12 items-start max-w-4xl mx-auto">

        <!-- Calculator -->
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 shadow-[var(--shadow-card)]">
          <h2 class="font-heading font-bold text-xl text-primary-900 mb-6">Calculate Your Savings</h2>

          <div class="space-y-6" id="savings-tool">

            <div>
              <label for="reactiveVisits" class="block text-sm font-medium text-neutral-700 mb-2">
                <!-- CUSTOMIZE: Adjust label for your niche -->
                Estimated reactive/emergency calls per year
              </label>
              <input type="range" id="reactiveVisits" min="1" max="12" step="1" value="4" class="w-full accent-accent-500" />
              <div class="flex justify-between text-xs text-neutral-400 mt-1">
                <span>1 call</span>
                <span id="reactiveVisitsValue" class="font-semibold text-neutral-900 text-sm">4 calls/year</span>
                <span>12 calls</span>
              </div>
            </div>

            <div>
              <label for="avgCallCost" class="block text-sm font-medium text-neutral-700 mb-2">
                <!-- CUSTOMIZE: Typical emergency/reactive call price for your niche -->
                Average cost per reactive call ($)
              </label>
              <input type="range" id="avgCallCost" min="100" max="2000" step="50" value="600" class="w-full accent-accent-500" />
              <div class="flex justify-between text-xs text-neutral-400 mt-1">
                <span>$100</span>
                <span id="avgCallCostValue" class="font-semibold text-neutral-900 text-sm">$600/call</span>
                <span>$2,000</span>
              </div>
            </div>

            <div>
              <label for="planCost" class="block text-sm font-medium text-neutral-700 mb-2">
                <!-- CUSTOMIZE: Monthly maintenance plan cost for your niche -->
                Monthly maintenance plan cost ($)
              </label>
              <input type="range" id="planCost" min="50" max="500" step="25" value="150" class="w-full accent-accent-500" />
              <div class="flex justify-between text-xs text-neutral-400 mt-1">
                <span>$50/mo</span>
                <span id="planCostValue" class="font-semibold text-neutral-900 text-sm">$150/mo</span>
                <span>$500/mo</span>
              </div>
            </div>

            <!-- Results -->
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-red-50 border border-red-100 rounded-xl p-4 text-center">
                <p class="text-xs text-red-500 font-semibold uppercase tracking-wide mb-1">Reactive (annual)</p>
                <p id="reactiveCost" class="font-heading font-bold text-2xl text-red-600">$2,400</p>
              </div>
              <div class="bg-green-50 border border-green-100 rounded-xl p-4 text-center">
                <p class="text-xs text-green-600 font-semibold uppercase tracking-wide mb-1">Recurring (annual)</p>
                <p id="recurringCost" class="font-heading font-bold text-2xl text-green-600">$1,800</p>
              </div>
            </div>

            <div class="bg-primary-900 text-white rounded-xl p-5 text-center">
              <p class="text-white/60 text-sm mb-1">Estimated annual savings with recurring service</p>
              <p id="savingsOutput" class="font-heading font-bold text-4xl text-accent-300">$600</p>
              <p id="savingsPercentOutput" class="text-white/50 text-xs mt-1">25% less than reactive calls</p>
            </div>

            <p class="text-xs text-neutral-400 text-center">
              This is an illustrative estimate. Actual costs vary by property and service scope.
            </p>

            <a
              href="/contact"
              class="block w-full text-center bg-accent-500 hover:bg-accent-600 text-white font-bold py-4 rounded-xl transition-colors"
            >
              Get Recurring Service Pricing
            </a>
          </div>
        </div>

        <!-- Info -->
        <div class="space-y-6">
          <div>
            <h2 class="font-heading font-bold text-2xl text-primary-900 mb-3">
              Why Recurring Service Costs Less
            </h2>
            <p class="text-neutral-600 leading-relaxed text-sm">
              <!-- CUSTOMIZE: Adapt this explanation for your niche. -->
              Emergency and reactive service calls are always more expensive than planned maintenance.
              When problems build up — overgrown trees, deferred trimming, ignored hazards — the cost
              of fixing them is significantly higher than the cost of preventing them.
              Regular scheduled service also gets you priority scheduling and lower per-visit rates.
            </p>
          </div>

          <div class="space-y-4">
            {[
              { title: "Prevention over reaction", desc: "Small, regular maintenance prevents the expensive emergencies." },
              { title: "Priority scheduling", desc: "Recurring customers get priority during high-demand periods and after storms." },
              { title: "Lower per-visit cost", desc: "Recurring plans include discounts that aren't available for one-time calls." },
              { title: "No more surprise bills", desc: "Flat monthly pricing means no budget surprises, ever." },
            ].map((item) => (
              <div class="flex gap-3">
                <div class="w-8 h-8 bg-green-100 text-green-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-primary-900 text-sm">{item.title}</div>
                  <div class="text-neutral-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-primary-900 text-white rounded-xl p-6">
            <p class="font-semibold text-sm mb-2">Ask about recurring plans:</p>
            <a href={`tel:${business.phoneRaw}`} class="text-accent-300 hover:text-accent-200 font-bold text-xl transition-colors">
              {business.phone}
            </a>
            <p class="text-white/50 text-xs mt-1">Mon–Sat 7am–7pm</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const reactiveVisitsEl = document.getElementById("reactiveVisits") as HTMLInputElement;
  const avgCallCostEl    = document.getElementById("avgCallCost") as HTMLInputElement;
  const planCostEl       = document.getElementById("planCost") as HTMLInputElement;

  const reactiveVisitsVal = document.getElementById("reactiveVisitsValue") as HTMLSpanElement;
  const avgCallCostVal    = document.getElementById("avgCallCostValue") as HTMLSpanElement;
  const planCostVal       = document.getElementById("planCostValue") as HTMLSpanElement;

  const reactiveCostEl    = document.getElementById("reactiveCost") as HTMLParagraphElement;
  const recurringCostEl   = document.getElementById("recurringCost") as HTMLParagraphElement;
  const savingsOutputEl   = document.getElementById("savingsOutput") as HTMLParagraphElement;
  const savingsPctEl      = document.getElementById("savingsPercentOutput") as HTMLParagraphElement;

  function fmt(n: number) { return `$${n.toLocaleString()}`; }

  function calculate() {
    const visits   = parseInt(reactiveVisitsEl.value, 10);
    const callCost = parseInt(avgCallCostEl.value, 10);
    const monthly  = parseInt(planCostEl.value, 10);

    reactiveVisitsVal.textContent = `${visits} call${visits !== 1 ? "s" : ""}/year`;
    avgCallCostVal.textContent    = `${fmt(callCost)}/call`;
    planCostVal.textContent       = `${fmt(monthly)}/mo`;

    const reactive  = visits * callCost;
    const recurring = monthly * 12;
    const savings   = Math.max(0, reactive - recurring);
    const pct       = reactive > 0 ? Math.round((savings / reactive) * 100) : 0;

    reactiveCostEl.textContent  = fmt(reactive);
    recurringCostEl.textContent = fmt(recurring);
    savingsOutputEl.textContent = fmt(savings);
    savingsPctEl.textContent    = savings > 0
      ? `${pct}% less than reactive calls`
      : "Similar cost — but you get priority scheduling and prevention";
  }

  reactiveVisitsEl.addEventListener("input", calculate);
  avgCallCostEl.addEventListener("input", calculate);
  planCostEl.addEventListener("input", calculate);
  calculate();
</script>
