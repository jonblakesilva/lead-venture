---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

// CUSTOMIZE: Replace with real reviews from your Google/Facebook/Nextdoor profiles.
const reviews = [
  {
    name: "Sarah M.",
    location: `${business.city}, ${business.state}`,
    rating: 5,
    date: "2 weeks ago",
    text: "Absolutely fantastic work. The crew showed up on time, worked efficiently, and left the property spotless. I've already recommended them to three neighbors. Worth every penny.",
    platform: "Google",
    avatar: "SM",
  },
  {
    name: "James R.",
    location: `${business.city}, ${business.state}`,
    rating: 5,
    date: "1 month ago",
    text: "Had a large job that needed to be done quickly before a storm. They fit me in the same day and handled everything professionally. Price was very fair. Will absolutely use again.",
    platform: "Google",
    avatar: "JR",
  },
  {
    name: "Linda K.",
    location: "Perrysburg, OH",
    rating: 5,
    date: "6 weeks ago",
    text: "I got quotes from three companies. These guys were the most professional by far — showed up when they said they would, explained exactly what they'd do, and the result was perfect.",
    platform: "Google",
    avatar: "LK",
  },
  {
    name: "Tom D.",
    location: "Maumee, OH",
    rating: 5,
    date: "2 months ago",
    text: "Emergency situation with a fallen branch threatening my roof. They were there within 2 hours and had it handled safely. Incredible response time and very reasonable price.",
    platform: "Google",
    avatar: "TD",
  },
  {
    name: "Rachel P.",
    location: "Sylvania, OH",
    rating: 5,
    date: "3 months ago",
    text: "Hired them for stump grinding after another company told me it would take 3 weeks. They came out in 2 days and finished in under an hour. Clean, fast, professional.",
    platform: "Facebook",
    avatar: "RP",
  },
  {
    name: "Mike F.",
    location: `${business.city}, ${business.state}`,
    rating: 5,
    date: "4 months ago",
    text: "Best decision I made this year. The old oak was a serious hazard, and they handled the entire removal safely with zero damage to my lawn or fence. Highly recommend.",
    platform: "Google",
    avatar: "MF",
  },
];

// CUSTOMIZE: Platform review counts and links.
const platforms = [
  { name: "Google", rating: business.rating, count: Math.round(business.reviewCount * 0.65), link: business.socials.google || "#", color: "text-blue-600" },
  { name: "Facebook", rating: "4.9", count: Math.round(business.reviewCount * 0.25), link: business.socials.facebook || "#", color: "text-blue-700" },
  { name: "Nextdoor", rating: "4.8", count: Math.round(business.reviewCount * 0.10), link: business.socials.nextdoor || "#", color: "text-green-600" },
];

// CUSTOMIZE: Add real certifications, awards, and badges your business holds.
const credentials = [
  { title: "Licensed & Insured", desc: "Fully licensed and carrying $2M liability coverage." },
  { title: "Locally Owned", desc: `${business.stats.yearsInBusiness}+ years serving ${business.city} and surrounding communities.` },
  { title: business.guaranteeText, desc: "If you're not satisfied, we come back and make it right — free." },
  { title: "Background-Checked Crew", desc: "Every team member is vetted, uniformed, and professional." },
  // { title: "ISA Certified Arborist", desc: "Internationally certified arborists on every crew. <!-- CUSTOMIZE -->" },
];
---

<Layout
  title="Why Customers Trust Us"
  description={`See real reviews, photos, and proof of why ${business.name} is the #1 rated ${business.niche} company in ${business.city}, ${business.state}.`}
>

  <!-- Header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Social Proof</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Why Customers Choose Us
        </h1>
        <p class="text-white/70 text-lg mt-4 leading-relaxed">
          Real reviews, real results, real credentials. Here's the proof behind every claim we make.
        </p>
      </div>
    </div>
  </section>

  <!-- Aggregate rating hero -->
  <section class="py-16 bg-white border-b border-neutral-100">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-12">

        <!-- Big rating display -->
        <div class="text-center lg:text-left" data-aos="fade-right">
          <p class="font-heading font-bold text-8xl text-primary-900 leading-none">{business.rating}</p>
          <div class="flex items-center justify-center lg:justify-start gap-1 mt-3">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <p class="text-neutral-500 text-base mt-2">Based on {business.reviewCount}+ verified reviews</p>
        </div>

        <!-- Platform breakdown -->
        <div class="grid grid-cols-3 gap-6 lg:gap-10" data-aos="fade-left">
          {platforms.map((p) => (
            <a href={p.link} target={p.link !== "#" ? "_blank" : undefined} rel="noopener noreferrer"
              class="text-center group hover:opacity-80 transition-opacity">
              <p class={`font-heading font-bold text-3xl ${p.color}`}>{p.rating}</p>
              <div class="flex justify-center gap-0.5 mt-1">
                {Array.from({ length: 5 }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                ))}
              </div>
              <p class="text-neutral-600 font-semibold text-sm mt-1">{p.name}</p>
              <p class="text-neutral-400 text-xs">{p.count}+ reviews</p>
            </a>
          ))}
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4" data-aos="fade-left" data-aos-delay="100">
          {[
            { value: `${business.stats.jobsCompleted.toLocaleString()}+`, label: "Jobs Completed" },
            { value: `${business.stats.yearsInBusiness}+`, label: "Years in Business" },
            { value: `${business.stats.satisfactionRate}%`, label: "Satisfaction Rate" },
            { value: `${business.stats.citiesServed}+`, label: "Cities Served" },
          ].map((stat) => (
            <div class="bg-neutral-50 rounded-xl p-4 text-center border border-neutral-100">
              <p class="font-heading font-bold text-2xl text-primary-900">{stat.value}</p>
              <p class="text-neutral-500 text-xs mt-1">{stat.label}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Reviews grid -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="text-center max-w-2xl mx-auto mb-12" data-aos="fade-up">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900">What Customers Say</h2>
        <p class="text-neutral-500 text-lg mt-3">
          Verified reviews from real customers — unedited and direct.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {reviews.map((r, i) => (
          <div
            class="bg-white rounded-2xl p-6 border border-neutral-200 flex flex-col shadow-sm"
            data-aos="fade-up"
            data-aos-delay={(i % 3) * 75}
          >
            <!-- Stars + platform -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex gap-0.5">
                {Array.from({ length: r.rating }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                ))}
              </div>
              <span class="text-xs text-neutral-400 font-medium">{r.platform}</span>
            </div>

            <!-- Review text -->
            <p class="text-neutral-700 text-sm leading-relaxed flex-1">"{r.text}"</p>

            <!-- Reviewer info -->
            <div class="flex items-center gap-3 mt-5 pt-5 border-t border-neutral-100">
              <div class="w-9 h-9 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center text-xs font-bold shrink-0">
                {r.avatar}
              </div>
              <div>
                <p class="font-semibold text-primary-900 text-sm">{r.name}</p>
                <p class="text-neutral-400 text-xs">{r.location} · {r.date}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Leave a review CTA -->
      {business.socials.google && (
        <div class="text-center mt-10" data-aos="fade-up">
          <a
            href={business.socials.google}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-primary-800 text-primary-800 hover:bg-primary-50 font-semibold px-6 py-3 rounded-xl transition-colors text-sm"
          >
            Leave Us a Review on Google
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Credentials & trust signals -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="text-center max-w-2xl mx-auto mb-12" data-aos="fade-up">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900">Our Credentials</h2>
        <p class="text-neutral-500 text-lg mt-3">
          The standards we hold ourselves to — and the commitments we make to every customer.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {credentials.map((c, i) => (
          <div
            class="p-6 bg-neutral-50 border border-neutral-200 rounded-2xl"
            data-aos="fade-up"
            data-aos-delay={(i + 1) * 75}
          >
            <div class="w-10 h-10 bg-accent-100 text-accent-600 rounded-xl flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-primary-900 text-base mb-1">{c.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Before / After preview -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="text-center max-w-2xl mx-auto mb-12" data-aos="fade-up">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900">Before & After</h2>
        <p class="text-neutral-500 text-lg mt-3">
          The transformation speaks for itself.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            before: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=400&h=320&q=80",
            after:  "https://images.unsplash.com/photo-1558449028-b53a39d100fc?auto=format&fit=crop&w=400&h=320&q=80",
            label: "Tree Removal",
          },
          {
            before: "https://images.unsplash.com/photo-1504701954957-2010ec3bcec1?auto=format&fit=crop&w=400&h=320&q=80",
            after:  "https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=400&h=320&q=80",
            label: "Tree Trimming",
          },
          {
            before: "https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?auto=format&fit=crop&w=400&h=320&q=80",
            after:  "https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=400&h=320&q=80",
            label: "Stump Grinding",
          },
        ].map((item, i) => (
          <div class="rounded-2xl overflow-hidden shadow-md" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="relative aspect-[4/3]">
              <div class="absolute inset-y-0 left-0 w-1/2 overflow-hidden">
                <img src={item.before} alt={`${item.label} before`} class="absolute inset-0 w-[200%] h-full object-cover" loading="lazy" />
              </div>
              <div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden">
                <img src={item.after} alt={`${item.label} after`} class="absolute inset-0 w-[200%] h-full object-cover" style="right:0;left:auto;" loading="lazy" />
              </div>
              <div class="absolute inset-y-0 left-1/2 w-0.5 bg-white/60 z-10"></div>
              <span class="absolute top-2 left-2 z-20 bg-black/50 text-white text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full">Before</span>
              <span class="absolute top-2 right-2 z-20 bg-primary-700/80 text-white text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full">After</span>
            </div>
            <div class="bg-white px-4 py-3 border-t border-neutral-100">
              <p class="font-semibold text-primary-900 text-sm">{item.label}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10" data-aos="fade-up">
        <a href="/gallery" class="text-accent-600 hover:text-accent-700 font-semibold text-sm underline underline-offset-4">
          View full project gallery →
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-primary-900 text-white text-center">
    <div class="max-w-2xl mx-auto px-5" data-aos="fade-up">
      <h2 class="font-heading text-3xl lg:text-4xl font-bold">Ready to Become Our Next Success Story?</h2>
      <p class="text-white/70 text-lg mt-4">
        Join {business.reviewCount}+ satisfied customers. Get your free, no-obligation quote today.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-8">
        <a href="/contact" class="bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors shadow-md">
          Get a Free Quote
        </a>
        <a href={`tel:${business.phoneRaw}`} class="border-2 border-white/30 hover:border-white text-white font-bold px-8 py-4 rounded-xl transition-colors">
          {business.phone}
        </a>
      </div>
    </div>
  </section>

</Layout>
