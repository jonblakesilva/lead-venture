<script>
  const toggle = document.getElementById("billing-toggle") as HTMLInputElement | null;
  const monthlyLabel = document.getElementById("billing-label-monthly");
  const annualLabel = document.getElementById("billing-label-annual");

  toggle?.addEventListener("change", () => {
    const isAnnual = toggle.checked;
    document.querySelectorAll(".pricing-scope .price-monthly").forEach((el) => el.classList.toggle("hidden", isAnnual));
    document.querySelectorAll(".pricing-scope .price-annual").forEach((el) => el.classList.toggle("hidden", !isAnnual));
    monthlyLabel?.classList.toggle("text-slate-900", !isAnnual);
    monthlyLabel?.classList.toggle("text-slate-500", isAnnual);
    annualLabel?.classList.toggle("text-slate-900", isAnnual);
    annualLabel?.classList.toggle("text-slate-500", !isAnnual);
  });
</script>
