---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const plans = [
  {
    name: "Starter",
    price: "$49",
    value: "A clean customer-facing website that gets you online fast and makes your service business look more credible from day one.",
    features: ["Custom lead-gen website", "Mobile-first design", "Basic SEO setup", "Lead form + call tracking", "Monthly optimization review"],
    featured: false,
  },
  {
    name: "Growth",
    price: "$97",
    value: "The most popular option for contractors who need better conversion, faster follow-up, and more review momentum without agency headaches.",
    features: ["Everything in Starter", "AI text-to-lead follow-up", "Review request automation", "Google Business Profile optimization", "Conversion reporting dashboard"],
    featured: true,
  },
  {
    name: "Full Suite",
    price: "$297",
    value: "For businesses ready to run a complete local marketing system: web, reviews, AI receptionist, and nurture campaigns working together.",
    features: ["Everything in Growth", "AI receptionist + missed-call recovery", "Advanced CRM + automation setup", "Re-marketing and lead nurturing", "Priority support and strategy calls"],
    featured: false,
  },
];

const faqs = [
  { question: "Is there really no contract?", answer: "Yes. We keep it simple and low-risk. No long-term lock-in, no setup fee trap, and no pressure to stay if the system isn't delivering." },
  { question: "Can I change plans later?", answer: "Absolutely. Most contractors start with one package and upgrade as their lead flow grows. We can expand the system without starting over from scratch." },
  { question: "What happens after the first spots are filled?", answer: "We cap new partner spots to keep quality high and ensure every client still gets real attention. When space opens up, the waitlist receives priority access." },
  { question: "What happens to my data if I cancel?", answer: "You keep your website assets and content. We will walk you through the handoff steps and make sure your business isn't left with an unusable setup." },
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: `${business.name} Pricing`,
  itemListElement: plans.map((plan) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: plan.name,
      description: plan.value,
      provider: {
        "@type": "LocalBusiness",
        name: business.name,
      },
      offers: {
        "@type": "Offer",
        price: plan.price.replace(/[^\d.]/g, ""),
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    },
  })),
  mainEntity: {
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
};
---

<Layout title="Simple Pricing" description={`See transparent pricing for ${business.name} website design, review systems, AI follow-up, and local lead-generation services.`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  </Fragment>
  <section class="bg-[#1A1D27] py-16 text-white md:py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">Simple, transparent pricing</p>
        <h1 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-6xl">The system that makes growth easier without the agency mess.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
          Choose the plan that matches your business today and scale into a fuller system when you're ready. No bloated retainers, no hidden fees, no pressure.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f7f7] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-8 lg:grid-cols-3">
        {plans.map((plan) => (
          <div class:list={["rounded-[30px] border p-8 shadow-sm", plan.featured ? "border-[#1A1D27] bg-[#1A1D27] text-white shadow-xl" : "border-slate-200 bg-white text-slate-900"]}>
            <div class="flex items-center justify-between gap-3">
              <h2 class:list={["text-2xl font-bold", plan.featured ? "text-white" : "text-primary-900"]}>{plan.name}</h2>
              {plan.featured && <span class="rounded-full bg-accent-500 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-white">Most popular</span>}
            </div>

            <div class="mt-6 flex items-baseline gap-2">
              <span class:list={["font-heading text-5xl font-black tracking-tight", plan.featured ? "text-white" : "text-primary-900"]}>{plan.price}</span>
              <span class:list={["text-sm", plan.featured ? "text-white/70" : "text-slate-500"]}>/mo</span>
            </div>

            <p class:list={["mt-4 text-sm leading-relaxed", plan.featured ? "text-white/75" : "text-slate-600"]}>{plan.value}</p>

            <ul class="mt-8 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span class:list={["mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full text-xs font-bold", plan.featured ? "bg-white/10 text-accent-300" : "bg-accent-100 text-accent-700"]}>✓</span>
                  <span class:list={["text-sm", plan.featured ? "text-white/85" : "text-slate-700"]}>{feature}</span>
                </li>
              ))}
            </ul>

            <a href="/contact" class:list={["mt-8 inline-flex w-full items-center justify-center rounded-xl px-5 py-3 text-base font-semibold transition-colors", plan.featured ? "bg-accent-500 text-white hover:bg-accent-600" : "bg-slate-900 text-white hover:bg-slate-800"]}>Get started</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto max-w-4xl rounded-[32px] border border-slate-200 bg-slate-50 p-8 md:p-12">
        <p class="mb-3 text-center text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">Two guarantees. Zero risk.</p>
        <h2 class="text-center font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">The double guarantee.</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-600">The performance guarantee</div>
            <p class="mt-4 text-slate-700">We double your investment in month one, or we keep working until we do. That's the accountability standard we stand behind.</p>
          </div>
          <div class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-600">The no-regrets guarantee</div>
            <p class="mt-4 text-slate-700">If you don't love the system after 14 days, walk away and pay nothing. No hard feelings, no bait-and-switch, no wasted time.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f7f7] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">FAQ</p>
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">Frequently asked questions</h2>
      </div>

      <div class="mx-auto max-w-4xl space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary-900">{faq.question}</h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
