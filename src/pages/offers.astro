---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

// CUSTOMIZE: Edit these offers. Remove any that don't apply.
// Set enabled: false to hide an offer without deleting it.
const offers = [
  {
    enabled: true,
    badge: "Limited Time",
    title: "10% Off Any Service — New Customers",
    description:
      "First-time customers receive 10% off their first service. Mention this offer when you call or submit your request.",
    expires: "Expires end of month",
    cta: "Claim This Offer",
    href: "/contact",
  },
  {
    enabled: true,
    badge: "Bundle & Save",
    title: "Free Cleanup With Any Large Job",
    description:
      "Book any qualifying job and we'll include full site cleanup at no additional charge — leaves, debris, and haul-away included.",
    expires: "While availability lasts",
    cta: "Get a Free Estimate",
    href: "/contact",
  },
  {
    enabled: true,
    badge: "Referral Bonus",
    title: "Give $50, Get $50",
    description:
      "Refer a friend or neighbor and you both save. They get $50 off their first service — you get a $50 credit toward your next.",
    expires: "No expiration",
    cta: "Refer Someone",
    href: "/contact",
  },
  {
    enabled: false,
    badge: "Seasonal",
    title: "Spring Cleanup Special",
    description:
      "Get your property ready for the season. Call for current pricing on our spring cleanup packages.",
    expires: "Seasonal offer",
    cta: "Get Details",
    href: "/contact",
  },
];

const activeOffers = offers.filter((o) => o.enabled);
---

<Layout
  title="Current Offers & Specials"
  description={`Save on ${business.niche} services with current offers and promotions from ${business.name}. ${business.city}, ${business.state}. Call ${business.phone}.`}
>
  <!-- Page header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Promotions</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Current Offers & Specials
        </h1>
        <p class="text-white/70 text-lg mt-4 leading-relaxed">
          Take advantage of our current promotions. Call {business.phone} to redeem — just mention the offer.
        </p>
      </div>
    </div>
  </section>

  <!-- Offers grid -->
  <section class="py-20 lg:py-28 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">

      {activeOffers.length === 0 ? (
        <div class="text-center py-16">
          <p class="text-neutral-500 text-lg">No active offers right now — check back soon or call us for current pricing.</p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 mt-6 bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 py-3.5 rounded-xl transition-colors"
          >
            Get a Free Quote
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {activeOffers.map((offer) => (
            <div class="bg-white rounded-2xl border border-neutral-200 shadow-sm overflow-hidden flex flex-col">
              <!-- Offer badge -->
              <div class="bg-accent-500 px-5 py-2.5 flex items-center justify-between">
                <span class="text-white text-xs font-bold uppercase tracking-widest">{offer.badge}</span>
                <span class="text-white/70 text-xs">{offer.expires}</span>
              </div>

              <!-- Offer content -->
              <div class="p-6 flex-1 flex flex-col">
                <h2 class="font-heading text-xl font-bold text-primary-900 mb-3 leading-tight">
                  {offer.title}
                </h2>
                <p class="text-neutral-600 text-sm leading-relaxed flex-1">
                  {offer.description}
                </p>

                <div class="mt-6 pt-5 border-t border-neutral-100 flex items-center justify-between gap-3">
                  <a
                    href={offer.href}
                    class="inline-flex items-center gap-1.5 bg-accent-500 hover:bg-accent-600 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-colors"
                  >
                    {offer.cta}
                  </a>
                  <a
                    href={`tel:${business.phoneRaw}`}
                    class="text-sm text-primary-700 hover:text-accent-600 font-semibold transition-colors"
                  >
                    or call {business.phone}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Fine print -->
      <p class="text-neutral-400 text-xs text-center mt-10 max-w-lg mx-auto leading-relaxed">
        Offers are subject to change without notice. Cannot be combined with other promotions unless otherwise stated.
        Contact us to confirm availability before scheduling.
      </p>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 lg:py-20 bg-primary-900 text-white">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5 text-center">
      <h2 class="font-heading text-3xl lg:text-4xl font-bold text-white mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-white/70 text-lg mb-8 max-w-xl mx-auto leading-relaxed">
        Call or fill out the form — our team will confirm your savings and get you scheduled.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          Call {business.phone}
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-4 rounded-xl transition-colors text-base"
        >
          Request a Quote Online →
        </a>
      </div>
    </div>
  </section>
</Layout>
