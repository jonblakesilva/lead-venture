---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleSchema from "@/components/articleschema.astro";
import { business } from "@/config/business";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => !data.draft);
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const words = entry.body.split(/\s+/).length;
const readTime = Math.ceil(words / 200);

const formattedDate = entry.data.publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const serviceLinks = business.primaryServices.map((name) => ({
  label: name,
  href: `/services/${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
}));
---

<Layout title={entry.data.title} description={entry.data.snippet}>
  <Fragment slot="head">
    <ArticleSchema
      title={entry.data.title}
      description={entry.data.snippet}
      publishDate={entry.data.publishDate}
      author={entry.data.author}
      image={entry.data.image?.src}
    />
  </Fragment>

  <!-- Hero image -->
  {entry.data.image?.src && (
    <div class="w-full h-64 md:h-80 lg:h-96 overflow-hidden bg-primary-900 relative">
      <img
        src={entry.data.image.src}
        alt={entry.data.image.alt ?? entry.data.title}
        class="w-full h-full object-cover opacity-60"
        width="1200"
        height="630"
        loading="eager"
        decoding="sync"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 to-transparent"></div>
    </div>
  )}

  <!-- Article container -->
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="grid lg:grid-cols-[1fr_300px] gap-12 py-12">

      <!-- Main article column -->
      <article>

        <!-- Meta -->
        <div class="mb-8">
          <span class="inline-block bg-accent-100 text-accent-700 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-4">
            {entry.data.category}
          </span>
          <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-primary-900 leading-tight">
            {entry.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-3 mt-4 text-sm text-neutral-500">
            <span>{entry.data.author}</span>
            <span>·</span>
            <time datetime={entry.data.publishDate.toISOString()}>{formattedDate}</time>
            <span>·</span>
            <span>{readTime} min read</span>
          </div>
        </div>

        <!-- TLDR box (optional) -->
        {entry.data.tldr && entry.data.tldr.length > 0 && (
          <div class="not-prose bg-primary-50 border-l-4 border-accent-500 rounded-xl p-6 mb-8">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <span class="font-heading font-bold text-primary-900 text-sm uppercase tracking-wide">Quick Summary</span>
            </div>
            <ul class="space-y-2">
              {entry.data.tldr.map((point: string) => (
                <li class="flex items-start gap-2.5 text-sm text-primary-800 leading-snug">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- TOC (filled by JS) -->
        <nav id="toc-container" class="not-prose hidden bg-neutral-50 border border-neutral-200 rounded-xl p-5 mb-8" aria-label="Table of contents">
          <button id="toc-toggle" class="flex items-center justify-between w-full text-left" aria-expanded="true">
            <span class="font-heading font-bold text-primary-900 text-sm uppercase tracking-wide">In this article</span>
            <svg id="toc-chevron" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <ol id="toc-list" class="mt-3 space-y-1.5 list-none"></ol>
        </nav>

        <!-- Content -->
        <div
          id="article-body"
          class="prose prose-neutral max-w-none prose-headings:font-heading prose-headings:text-primary-900 prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-primary-900 prose-li:text-neutral-700 prose-p:text-neutral-700 prose-p:leading-relaxed"
        >
          <Content />
        </div>

        <!-- Bottom CTA -->
        <div class="not-prose mt-14 p-8 bg-primary-900 rounded-2xl text-white text-center">
          <p class="font-heading font-bold text-2xl mb-2">Ready to get started?</p>
          <p class="text-white/70 text-sm mb-6 max-w-md mx-auto">
            {business.name} provides free estimates in {business.city} and the surrounding area. Call or fill out our form — we respond the same business day.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href={`tel:${business.phoneRaw}`}
              class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 py-3.5 rounded-xl transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
              </svg>
              {business.phone}
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/70 text-white font-semibold px-7 py-3.5 rounded-xl transition-colors"
            >
              Free Estimate Online →
            </a>
          </div>
        </div>

        <!-- Back link -->
        <div class="not-prose mt-8">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm text-neutral-500 hover:text-primary-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Blog
          </a>
        </div>

      </article>

      <!-- Sticky sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-5">

          <!-- Sidebar CTA -->
          <div class="bg-primary-900 text-white rounded-2xl p-6">
            <p class="font-heading font-bold text-lg mb-2">Free Estimate</p>
            <p class="text-white/60 text-sm mb-5 leading-relaxed">
              Serving {business.city} and surrounding areas. Same-day response guaranteed.
            </p>
            <a
              href={`tel:${business.phoneRaw}`}
              class="flex items-center justify-center gap-2 w-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-3.5 rounded-xl transition-colors text-sm mb-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
              </svg>
              {business.phone}
            </a>
            <a
              href="/contact"
              class="flex items-center justify-center w-full border border-white/30 hover:border-white/60 text-white text-sm font-medium py-2.5 rounded-xl transition-colors"
            >
              Get Quote Online →
            </a>
          </div>

          <!-- Services quicklinks -->
          <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-5">
            <p class="font-heading font-bold text-primary-900 text-xs uppercase tracking-wide mb-3">Our Services</p>
            <ul class="space-y-1.5">
              {serviceLinks.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-sm text-neutral-600 hover:text-accent-600 transition-colors">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          {entry.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag: string) => (
                <span class="bg-neutral-100 text-neutral-600 text-xs px-3 py-1.5 rounded-full">#{tag}</span>
              ))}
            </div>
          )}

        </div>
      </aside>

    </div>
  </div>
</Layout>

<script define:vars={{ phone: business.phone, phoneRaw: business.phoneRaw, businessName: business.name }}>
  // Auto-build TOC from h2 headings
  const body = document.getElementById("article-body");
  const tocContainer = document.getElementById("toc-container");
  const tocList = document.getElementById("toc-list");
  const tocToggle = document.getElementById("toc-toggle");
  const tocChevron = document.getElementById("toc-chevron");

  if (body && tocContainer && tocList) {
    const headings = Array.from(body.querySelectorAll("h2"));

    if (headings.length >= 2) {
      headings.forEach((h, i) => {
        const id = h.textContent
          ?.toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "") ?? `section-${i}`;
        h.id = id;

        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = h.textContent ?? "";
        a.className = "text-sm text-neutral-600 hover:text-accent-600 transition-colors leading-snug block py-0.5";
        li.appendChild(a);
        tocList.appendChild(li);
      });

      tocContainer.classList.remove("hidden");

      tocToggle?.addEventListener("click", () => {
        const expanded = tocToggle.getAttribute("aria-expanded") === "true";
        tocToggle.setAttribute("aria-expanded", String(!expanded));
        tocList.classList.toggle("hidden", expanded);
        tocChevron?.classList.toggle("rotate-180", !expanded);
      });

      // Inject mid-article CTAs after every 2nd h2
      const ctaHTML = `
        <div class="not-prose my-8 rounded-2xl overflow-hidden border border-accent-200 bg-accent-50 p-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <div class="flex-1">
            <p class="font-heading font-bold text-primary-900 text-base leading-tight">Have a question about your project?</p>
            <p class="text-neutral-600 text-sm mt-1">${businessName} offers free estimates with same-day response.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-2 shrink-0">
            <a href="tel:${phoneRaw}" class="inline-flex items-center justify-center gap-1.5 bg-accent-500 hover:bg-accent-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition-colors whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/></svg>
              ${phone}
            </a>
            <a href="/contact" class="inline-flex items-center justify-center border border-accent-400 text-accent-700 hover:bg-accent-100 font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors whitespace-nowrap">
              Free Quote →
            </a>
          </div>
        </div>`;

      headings.forEach((h, i) => {
        if ((i + 1) % 2 === 0) {
          const wrapper = document.createElement("div");
          wrapper.innerHTML = ctaHTML;
          h.parentNode?.insertBefore(wrapper, h.nextSibling);
        }
      });
    }
  }
</script>
