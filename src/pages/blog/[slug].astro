---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { business } from "@/config/business";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.mdx?$/, "");

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const otherPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? business.website;
const postUrl = `${siteUrl}/blog/${slug}`;
const postImage = post.data.image ?? `${siteUrl}/opengraph.jpg`;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  image: postImage,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: {
    "@type": post.data.author.includes(business.name) ? "Organization" : "Person",
    name: post.data.author,
  },
  publisher: {
    "@type": "Organization",
    name: business.name,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  keywords: post.data.tags.join(", "),
};
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  </Fragment>
  <article>
    <section class="border-b border-white/10 bg-[#1A1D27] py-20 text-white md:py-28">
      <div class="mx-auto max-w-4xl px-5">
        <nav class="mb-6 flex items-center gap-2 text-sm text-white/50">
          <a href="/" class="transition-colors hover:text-white">Home</a>
          <span>›</span>
          <a href="/blog" class="transition-colors hover:text-white">Blog</a>
        </nav>
        <div class="mb-6 inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm font-medium text-white/80">
          <span class="mr-2 h-2 w-2 rounded-full bg-accent-400"></span>
          {post.data.category}
        </div>
        <h1 class="font-heading text-4xl font-bold leading-[1.1] tracking-tight md:text-6xl">{post.data.title}</h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-white/80">{post.data.excerpt}</p>
        <div class="mt-8 flex items-center gap-3 text-sm text-white/60">
          <span>{post.data.author}</span>
          <span>•</span>
          <span>{formatDate(post.data.publishDate)}</span>
        </div>
      </div>
    </section>

    {post.data.image && (
      <div class="bg-neutral-100">
        <div class="mx-auto max-w-4xl px-5 py-10">
          <img src={post.data.image} alt={post.data.title} loading="lazy" class="w-full rounded-2xl object-cover shadow-xl" />
        </div>
      </div>
    )}

    <section class="bg-white py-20">
      <div class="mx-auto max-w-4xl px-5">
        <div class="prose prose-neutral max-w-none prose-headings:font-heading prose-headings:text-primary-900 prose-a:text-accent-600 prose-table:text-sm prose-blockquote:border-accent-400 prose-blockquote:text-primary-900 prose-blockquote:font-medium">
          <Content />
        </div>

        {post.data.tags.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-2 border-t border-neutral-200 pt-8">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </section>
  </article>

  {otherPosts.length > 0 && (
    <section class="border-t border-neutral-200 bg-neutral-50 py-20">
      <div class="mx-auto max-w-(--breakpoint-xl) px-5">
        <h2 class="mb-10 text-center font-heading text-3xl font-bold text-primary-900">More From The Blog</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {otherPosts.map((p) => (
            <a href={`/blog/${p.id.replace(/\.mdx?$/, "")}`} class="group rounded-3xl border border-neutral-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <div class="mb-3 inline-flex items-center rounded-full border border-accent-200 bg-accent-50 px-3 py-1 text-xs font-semibold text-accent-700">{p.data.category}</div>
              <h3 class="text-lg font-bold text-primary-900 line-clamp-2">{p.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600 line-clamp-3">{p.data.excerpt}</p>
              <div class="mt-5 text-sm font-semibold text-accent-600">Read more →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <TestimonialCarousel />

  <section class="bg-[#1A1D27] py-24 text-center text-white">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-heading text-3xl font-bold md:text-5xl">Ready to Put This Into Action?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-xl text-white/80">
        We build the website, systems, and follow-up so you can focus on running the business.
      </p>
      <a href="/contact" class="mt-10 inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">
        Request a Website
      </a>
    </div>
  </section>
</Layout>
