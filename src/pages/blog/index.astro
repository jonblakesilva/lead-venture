---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))];

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout title="Blog" description={`Practical marketing, sales, and growth advice for local trade and home service businesses from ${business.name}.`}>
  <section class="border-b border-white/10 bg-[#1A1D27] py-20 text-white md:py-28">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5 text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The Blog</p>
      <h1 class="font-heading text-4xl font-bold md:text-6xl">Growth advice for local service businesses.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-white/80">Practical marketing, sales, and operations tactics from people who've actually run trade businesses.</p>
    </div>
  </section>

  <section class="bg-neutral-50 py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      {categories.length > 0 && (
        <div class="mb-12 flex flex-wrap justify-center gap-3">
          {categories.map((cat) => (
            <span class="rounded-full border border-neutral-200 bg-white px-4 py-1.5 text-sm font-medium text-neutral-600">{cat}</span>
          ))}
        </div>
      )}

      {posts.length === 0 ? (
        <p class="text-center text-lg text-neutral-500">New posts coming soon.</p>
      ) : (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`} class="group flex flex-col overflow-hidden rounded-3xl border border-neutral-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              {post.data.image && (
                <div class="relative aspect-[16/10] overflow-hidden border-b bg-neutral-100">
                  <img src={post.data.image} alt={post.data.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-7">
                <div class="mb-3 flex items-center gap-3 text-xs font-semibold text-accent-600">
                  <span class="rounded-full bg-accent-50 px-2.5 py-1 uppercase tracking-wide">{post.data.category}</span>
                  <span class="text-neutral-400">{formatDate(post.data.publishDate)}</span>
                </div>
                <h2 class="mb-3 font-heading text-xl font-bold text-primary-900 line-clamp-2">{post.data.title}</h2>
                <p class="mb-6 flex-1 text-sm leading-relaxed text-neutral-600 line-clamp-3">{post.data.excerpt}</p>
                <div class="text-sm font-semibold text-accent-600">Read more →</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="bg-[#1A1D27] py-24 text-center text-white">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-heading text-3xl font-bold tracking-tight md:text-5xl">Ready to Put This Into Action?</h2>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-white/80">
        We build the website, systems, and follow-up so you can focus on running the business.
      </p>
      <a href="/contact" class="mt-10 inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">
        Request a Website
      </a>
    </div>
  </section>
</Layout>
