---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";
---

<Layout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist or was moved."
>
  <!-- Hero header -->
  <section class="bg-primary-900 text-white py-20 lg:py-28">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5 text-center">
      <p class="text-accent-400 font-bold text-7xl lg:text-9xl font-heading mb-4">404</p>
      <h1 class="font-heading text-3xl lg:text-4xl font-bold text-white leading-tight">
        Page Not Found
      </h1>
      <p class="text-white/70 text-lg mt-4 max-w-xl mx-auto leading-relaxed">
        Looks like this page doesn't exist or was moved. Here are a few places to get you back on track.
      </p>
    </div>
  </section>

  <!-- Quick links grid -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <h2 class="font-heading text-2xl font-bold text-primary-900 text-center mb-10">
        Where would you like to go?
      </h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-4xl mx-auto">
        <a
          href="/services"
          class="group flex flex-col items-center text-center p-7 bg-white border-2 border-neutral-200 rounded-2xl hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
        >
          <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-4 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-primary-900 group-hover:text-accent-600 transition-colors">Services</h3>
          <p class="text-neutral-500 text-xs mt-1">Browse what we offer</p>
        </a>

        <a
          href="/pricing"
          class="group flex flex-col items-center text-center p-7 bg-white border-2 border-neutral-200 rounded-2xl hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
        >
          <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-4 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 1.343-3 3v1h6v-1c0-1.657-1.343-3-3-3zm-5 3h10M8 16h8"/>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-primary-900 group-hover:text-accent-600 transition-colors">Pricing</h3>
          <p class="text-neutral-500 text-xs mt-1">See package options</p>
        </a>

        <a
          href="/about"
          class="group flex flex-col items-center text-center p-7 bg-white border-2 border-neutral-200 rounded-2xl hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
        >
          <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-4 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-primary-900 group-hover:text-accent-600 transition-colors">About Us</h3>
          <p class="text-neutral-500 text-xs mt-1">Who we are</p>
        </a>

        <a
          href="/contact"
          class="group flex flex-col items-center text-center p-7 bg-white border-2 border-neutral-200 rounded-2xl hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
        >
          <div class="w-12 h-12 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center mb-4 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-primary-900 group-hover:text-accent-600 transition-colors">Contact</h3>
          <p class="text-neutral-500 text-xs mt-1">Get a free quote</p>
        </a>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 bg-primary-900 hover:bg-primary-800 text-white font-bold px-8 py-4 rounded-xl transition-colors text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Go Back Home
        </a>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-colors text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          Call {business.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
