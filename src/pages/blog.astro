---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.publishDate < new Date())
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Blog"
  description={`Practical tips and resources from ${business.name} for homeowners in ${business.city}, ${business.state}.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Resources</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Tips & Guides
        </h1>
        <p class="text-white/70 text-lg mt-4 leading-relaxed">
          Practical advice for homeowners and useful resources from our team.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5 pb-12 lg:pb-20">
      {posts.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-neutral-500 text-lg">No posts yet. Check back soon.</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
          {posts.map((post, i) => (
            <article class="bg-white rounded-2xl border border-neutral-200 overflow-hidden flex flex-col hover:shadow-lg hover:border-neutral-300 transition-all duration-200 group">
              <a href={`/blog/${post.slug}`} class="block overflow-hidden aspect-[16/9] bg-neutral-100">
                {post.data.image?.src ? (
                  <img
                    src={post.data.image.src}
                    alt={post.data.image.alt ?? post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading={i < 3 ? "eager" : "lazy"}
                    decoding={i < 3 ? "sync" : "async"}
                    width="640"
                    height="360"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary-800 to-primary-600"></div>
                )}
              </a>
              <div class="p-6 flex flex-col flex-1">
                <span class="text-accent-600 text-[11px] font-bold uppercase tracking-widest mb-2">
                  {post.data.category}
                </span>
                <h2 class="font-heading text-xl font-bold text-primary-900 leading-snug mb-3 flex-1">
                  <a href={`/blog/${post.slug}`} class="hover:text-accent-600 transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                {post.data.snippet && (
                  <p class="text-neutral-500 text-sm leading-relaxed line-clamp-2 mb-4">
                    {post.data.snippet}
                  </p>
                )}
                <div class="pt-4 border-t border-neutral-100 flex items-center justify-between">
                  <time
                    class="text-neutral-400 text-xs"
                    datetime={post.data.publishDate.toISOString()}
                  >
                    {post.data.publishDate.toLocaleDateString("en-US", {
                      month: "long",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-accent-600 text-xs font-semibold hover:text-accent-700 transition-colors"
                  >
                    Read more →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
