---
import Layout from "@/layouts/Layout.astro";
import FaqAccordion from "@/components/faqaccordion.astro";
import { business } from "@/config/business";

const faqItems = [
  {
    question: `How quickly can you respond to an emergency in ${business.city}?`,
    answer: `For true emergencies, call us directly at ${business.phone}. We prioritize emergency calls and aim to dispatch a crew the same day, often within hours of your call.`,
  },
  {
    question: "Do you charge extra for emergency service?",
    answer: "Emergency calls may include a priority fee depending on timing and scope. We give you a clear estimate before any work begins so there are no surprises.",
  },
  {
    question: "What counts as a service emergency?",
    answer: "Any situation that poses an immediate safety risk to people or property — structural damage, hazardous conditions, active damage risk, or anything that cannot safely wait for a regular appointment.",
  },
  {
    question: "Are you available nights, weekends, and holidays?",
    answer: `Yes. Emergencies don't keep business hours. Call ${business.phone} any time and we'll assess your situation and dispatch as quickly as possible.`,
  },
  {
    question: "Will my homeowner's insurance cover emergency service?",
    answer: "In many cases, yes — especially when damage involves property or structures. We can provide documentation to support your claim. Contact your insurer and ask about emergency service coverage.",
  },
  {
    question: "What should I do while waiting for your crew?",
    answer: "Keep people and pets away from the hazard area. Do not attempt to remove debris or make repairs yourself. If there is active risk of injury, call 911 first, then call us.",
  },
];

const scenarios = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`,
    title: "Active Damage Risk",
    desc: "Anything threatening to collapse, fall, or cause further damage needs immediate attention. Don't wait.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
    title: "Storm Damage",
    desc: "High winds, ice, or heavy rain can cause sudden structural hazards. We respond fast after severe weather.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    title: "Property Threatened",
    desc: "When a hazard is directly threatening your home, vehicle, or structure, get us on the phone immediately.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "Can't Wait Until Monday",
    desc: "Some situations simply cannot wait. If you need help now, we're available nights, weekends, and holidays.",
  },
];
---

<Layout
  title="Emergency Service"
  description={`24/7 emergency ${business.niche} in ${business.city}, ${business.state}. Call ${business.phone} now for fast response — we're available nights, weekends, and holidays.`}
>

  <!-- Urgent header -->
  <section class="bg-red-700 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl">
        <p class="text-red-200 font-semibold text-sm uppercase tracking-widest mb-4">24/7 Emergency Response</p>
        <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">
          Emergency {business.niche}
        </h1>
        <p class="text-white/80 text-lg mt-4 leading-relaxed">
          When something can't wait, we're ready. Call now for immediate assistance in {business.city} and surrounding areas.
        </p>
      </div>
    </div>
  </section>

  <!-- Big phone CTA -->
  <section class="py-12 lg:py-16 bg-white border-b border-neutral-100">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-neutral-500 text-sm uppercase tracking-widest font-semibold mb-4">Call Now — We Answer</p>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white font-bold text-2xl lg:text-3xl px-10 py-5 rounded-2xl transition-colors shadow-lg shadow-red-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          {business.phone}
        </a>
        <p class="text-neutral-400 text-sm mt-4">Available 24 hours a day, 7 days a week</p>
        <div class="mt-6 flex items-center justify-center gap-6 text-sm text-neutral-500 flex-wrap">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Fast dispatch
          </span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Licensed and insured
          </span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Clear upfront estimate
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- When to call -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900">When to Call for Emergency Service</h2>
        <p class="text-neutral-500 text-lg mt-3">
          If you're asking whether it's an emergency, it probably is. Here are common situations we handle urgently.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {scenarios.map((s, i) => (
          <div class="bg-white rounded-2xl p-6 border border-neutral-200 shadow-sm" data-aos="fade-up" data-aos-delay={i * 75}>
            <div class="w-12 h-12 bg-red-50 text-red-600 rounded-xl flex items-center justify-center mb-4">
              <Fragment set:html={s.icon} />
            </div>
            <h3 class="font-heading font-bold text-primary-900 text-base mb-2">{s.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-aos="fade-right">
          <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">What Happens Next</p>
          <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900 leading-tight">
            How Emergency Response Works
          </h2>
          <p class="text-neutral-500 text-lg mt-4 leading-relaxed">
            We keep it simple so you can focus on staying safe while we handle the rest.
          </p>
          <ol class="mt-8 space-y-5">
            {[
              { step: "01", title: "Call Us Now", desc: `Dial ${business.phone} any time of day or night. A real person will answer and assess the situation.` },
              { step: "02", title: "We Dispatch Fast", desc: "We'll get a crew en route as quickly as possible, with an ETA given upfront." },
              { step: "03", title: "Clear Estimate First", desc: "Before any work begins, we'll give you a clear scope and price. No surprises." },
              { step: "04", title: "Problem Solved", desc: "We handle the emergency and leave your property safe and clean." },
            ].map((item) => (
              <li class="flex gap-5">
                <span class="font-heading font-bold text-accent-500 text-xl shrink-0 w-8">{item.step}</span>
                <div>
                  <p class="font-heading font-bold text-primary-900">{item.title}</p>
                  <p class="text-neutral-500 text-sm mt-1 leading-relaxed">{item.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="bg-red-50 border border-red-100 rounded-2xl p-8 text-center" data-aos="fade-left">
          <div class="w-16 h-16 bg-red-600 text-white rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
            </svg>
          </div>
          <p class="font-heading font-bold text-primary-900 text-2xl mb-2">Don't Wait</p>
          <p class="text-neutral-600 text-sm mb-6 leading-relaxed">
            Hazards get worse with time. Call now and let us assess the situation — there's no obligation to proceed.
          </p>
          <a
            href={`tel:${business.phoneRaw}`}
            class="inline-flex items-center gap-2 w-full justify-center bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-4 rounded-xl transition-colors text-lg mb-3"
          >
            {business.phone}
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 w-full justify-center border-2 border-primary-800 text-primary-800 hover:bg-primary-50 font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm"
          >
            Request a Callback →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">Questions</p>
          <h2 class="font-heading text-3xl lg:text-4xl font-bold text-primary-900 leading-tight">
            Emergency Service FAQ
          </h2>
          <p class="text-neutral-500 text-lg mt-4 leading-relaxed">
            Still have questions? Call us at{" "}
            <a href={`tel:${business.phoneRaw}`} class="text-accent-600 font-semibold hover:underline">
              {business.phone}
            </a>{" "}
            and we'll walk you through everything.
          </p>
        </div>
        <FaqAccordion items={faqItems} />
      </div>
    </div>
  </section>

</Layout>
