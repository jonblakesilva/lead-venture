---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";
import RoiCalculator from "@/components/RoiCalculator";
import HeroVideo from "@/components/HeroVideo.astro";

const featuredCaseStudySlugs = ["cold-outreach-case-study", "reputation-case-study", "speed-to-lead-case-study"];
const featuredCaseStudies = (await getCollection("case-studies", ({ data }) => !data.draft))
  .filter((study) => featuredCaseStudySlugs.includes(study.data.urlSlug))
  .sort((a, b) => featuredCaseStudySlugs.indexOf(a.data.urlSlug) - featuredCaseStudySlugs.indexOf(b.data.urlSlug));

const homepageFaqs = [
  {
    question: "What does The Lead Venture actually do for contractors?",
    answer: "We build and manage the digital growth system for home service businesses, including lead-generation websites, local SEO, review automation, AI follow-up, and conversion-focused messaging.",
  },
  {
    question: "Do you work with roofing, landscaping, plumbing, and other trade businesses?",
    answer: "Yes. The Lead Venture helps contractors across local home service industries generate more qualified leads and convert more inbound calls into booked jobs.",
  },
  {
    question: "How fast can a contractor get started?",
    answer: "Website live in as little as 72 hours. Full system setup — CRM, missed-call text-back, review automation — typically takes 3 to 7 days.",
  },
  {
    question: "Is there a contract or long-term commitment?",
    answer: "No. The Lead Venture is designed to be low-risk and transparent, with simple pricing and no long-term lock-in required.",
  },
];

const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout title="Built In The Trades. Not In A Marketing Agency." description="Get a modern website plus the systems that turn missed calls, Google searches, and past customers into booked jobs. Built by operators, not marketers.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </Fragment>
  <section class="relative overflow-hidden bg-[#1A1D27] py-16 text-white md:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(255,255,255,0.08),transparent_35%)]"></div>
    <div class="relative mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto max-w-5xl text-center">
        <div class="mb-6 inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-white/80">
          <span class="mr-2 h-2 w-2 rounded-full bg-accent-400"></span>
          One System. Built By Contractors, For Contractors.
        </div>

        <h1 class="mx-auto max-w-[16ch] font-heading text-5xl font-black leading-[0.92] tracking-[-0.06em] md:text-7xl lg:text-[4.5rem]">
          Built In The Trades. <span class="text-accent-400">Not In A Marketing Agency.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg text-white/75 md:text-2xl">
          We install the system that helps you get found, follow up faster, book more jobs, and get more reviews — get a modern website plus the automation that turns missed calls, Google searches, and past customers into booked jobs.
        </p>

        <HeroVideo src="https://storage.googleapis.com/msgsndr/6B4reCngPYfDkJwOtiM0/media/c0d59bec-d221-4eef-a987-9cdba06f740f.mp4" />

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/about/how-it-works" class="inline-flex h-12 items-center justify-center rounded-full border border-white/20 bg-white/5 px-8 text-base font-semibold text-white transition hover:bg-white/10">
            Watch Demo
          </a>
          <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-accent-500 px-8 text-base font-semibold text-white transition hover:bg-accent-600">
            Claim Your Free Website
          </a>
        </div>

        <div class="mt-10 flex flex-col items-center gap-4 text-sm text-white/70">
          <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
            <div class="flex items-center gap-2"><span class="text-accent-400">✓</span> $0 upfront, website live in as little as 72 hours</div>
            <div class="flex items-center gap-2"><span class="text-accent-400">✓</span> 40+ websites launched and counting</div>
            <div class="flex items-center gap-2"><span class="text-accent-400">✓</span> Average client stays 30+ months</div>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
            <div class="flex items-center gap-2"><span class="text-accent-400">✓</span> No contracts. No risk. Cancel anytime.</div>
            <div class="flex items-center gap-2"><span class="text-accent-400">✓</span> Built by actual trade operators</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto max-w-4xl rounded-[32px] border border-slate-200 bg-slate-50 p-8 md:p-12">
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.06em] text-primary-900 md:text-5xl">Why The Hell Is The Website Free?</h2>
        <div class="mt-6 space-y-4 text-lg text-slate-700">
          <p>We know contractors are skeptical. You get pitched by marketing agencies 10 times a day promising the moon.</p>
          <p>Here's the truth: the website build, custom copy, and asset engineering are 100% free. You only cover the secure monthly cloud hosting and optimization framework, or have us handle the live deployment for you.</p>
          <p>If the site doesn't make you money, you leave, and we lose. We're putting our own skin in the game.</p>
          <p class="font-bold text-primary-900">We Only Win When You Win.</p>
        </div>

        <div class="mt-8 flex justify-center">
          <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-accent-500 px-8 text-base font-semibold text-white transition hover:bg-accent-600">Claim Your Free Website</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F9FA] py-20 text-slate-900">
