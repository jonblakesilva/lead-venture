      </div>

      <div class="mt-10 text-center">
        <a href="/proof/case-studies" class="inline-flex h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-8 text-base font-semibold text-primary-900 transition hover:bg-slate-50">See All Case Studies</a>
      </div>
