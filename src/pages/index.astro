        <div class="rounded-[28px] border border-slate-200 bg-slate-50 p-7 shadow-sm">
          <div class="mb-4 inline-flex items-center rounded-full bg-accent-100 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-accent-700">Bonus #1</div>
          <h3 class="text-2xl font-bold text-primary-900">Optimized GMB Profile</h3>
          <div class="mt-2 text-lg font-semibold text-accent-600">$500 Value</div>
