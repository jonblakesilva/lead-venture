---
import Layout from "@/layouts/Layout.astro";
import ReviewWidget from "@/components/ReviewWidget.astro";
import FaqAccordion from "@/components/faqaccordion.astro";
import { Icon } from "astro-icon/components";

const BOOKING_URL = "https://links.theleadventure.com/widget/booking/MWI0QB7T4kwxvuDv74xM";

const categories = [
  {
    name: "Get Found",
    questions: [
      {
        q: "Is your Google Business Profile fully claimed, optimized, and active?",
        exp: "This includes categories, photos, posts, and keeping it updated, not just claiming it once.",
        tip: "Claim and fully build out your Google Business Profile, categories, photos, services, and posts. An incomplete or unclaimed profile means Google has nothing to show searchers, and you lose free visibility that costs nothing but time.",
      },
      {
        q: "Does your website actually get indexed and found on Google?",
        exp: "A site can look fine and still be invisible to search if it's not built or crawled correctly.",
        tip: "Check Google Search Console for indexing errors. A website that isn't indexed can't generate leads no matter how good it looks, this is foundational and should be fixed before anything else.",
      },
      {
        q: "Are you running consistent, tracked advertising (online or offline)?",
        exp: "Consistent means it runs on a schedule, tracked means you know what each dollar produced.",
        tip: "Start with one channel (Google, Facebook, or direct mail) and track cost-per-lead from day one. Untracked ad spend is just a guess, and guessing gets expensive fast.",
      },
      {
        q: "How fast do you respond to new leads and missed calls?",
        exp: "Minutes matter here. Businesses that respond within 5 minutes convert dramatically more than those that wait even 30.",
        tip: "Set up automated instant response for missed calls, texts, and form fills. Leads contacted within 5 minutes are up to 100x more likely to convert than those contacted after 30 minutes, this is one of the highest-leverage fixes available.",
      },
    ],
  },
  {
    name: "Get Paid More",
    questions: [
      {
        q: "Does your team consistently offer upsells or add-ons at the point of sale?",
        exp: "This means it happens every time, not just when someone remembers to ask.",
        tip: "Build a simple, standard upsell script or checklist your team uses on every job. Even a 10-20% attach rate on add-ons meaningfully increases average ticket size without needing a single new customer.",
      },
      {
        q: "Are your prices based on the value you provide, not fear of losing the job?",
        exp: "Underpricing out of fear is one of the most common silent profit leaks in service businesses.",
        tip: "Review your pricing against the actual value and outcome you deliver, not just your cost to deliver it. Many service businesses are underpriced by 15-30% simply because they never revisited pricing after their first year.",
      },
      {
        q: "Do you offer packaged or bundled services to increase the average ticket?",
        exp: "Think seasonal packages, maintenance plans, or tiered service levels.",
        tip: "Create one simple bundle or maintenance plan that combines your most common services at a slight discount. Bundling increases average ticket and makes repeat business automatic instead of optional.",
      },
      {
        q: "Do you actively track and work to increase your average ticket size?",
        exp: "If you don't know this number, you can't know if you're improving it.",
        tip: "Start tracking average ticket size monthly. What gets measured gets managed, and most businesses find easy wins the moment they start actually looking at this number.",
      },
    ],
  },
  {
    name: "Get Them Back",
    questions: [
      {
        q: "Do you have an active, ongoing system for generating new reviews?",
        exp: "Ongoing means ongoing, not a one-time push you did two years ago.",
        tip: "Set up an automated review request that fires after every job or appointment. Businesses running this consistently often add 100+ reviews within months, and reviews directly influence both trust and Google rankings.",
      },
      {
        q: "Do you have a system for staying in touch with past customers?",
        exp: "This means ongoing communication, not just their name sitting in a database.",
        tip: "Set up a simple recurring email or text touchpoint (seasonal tips, reminders, or offers) so past customers hear from you regularly. Silence is the main reason repeat customers quietly drift to a competitor.",
      },
      {
        q: "Do you actively ask for and incentivize referrals?",
        exp: "Hoping happy customers mention you isn't a referral system.",
        tip: "Set up a simple double-sided referral incentive, both the referrer and the new customer get something. This turns word-of-mouth from a happy accident into a predictable, repeatable source of new business.",
      },
      {
        q: "Have you run a reactivation campaign to past customers in the last 6 months?",
        exp: "A reactivation campaign is a targeted offer sent to your existing list to bring dormant customers back.",
        tip: "Run one targeted offer to your full customer list this quarter. This is usually the single fastest revenue win available, since these people already know and trust you, they just need a reason to come back.",
      },
    ],
  },
];

const faqs = [
  { question: "How long does this assessment take?", answer: "Less than 2 minutes. It's just 12 quick, multiple-choice questions designed specifically for local home service businesses." },
  { question: "What happens after I get my score?", answer: "You'll get a customized breakdown of your top 3 priority fixes immediately on the results screen. You'll also have the option to book a free, no-obligation growth audit with our team to help you implement these systems." },
  { question: "Is this really free?", answer: "Yes, 100% free. No credit card required, no paywalls. Just actionable insights for your business." },
  { question: "Who is this assessment for?", answer: "Home service business owners, contractors, roofers, landscapers, plumbers, and tradesmen who want to stop guessing, plug their revenue leaks, and start scaling predictably." },
];
---

<Layout
  title="Find Exactly Where Your Business is Leaking Revenue"
  description="Take this 2-minute Local Business Growth Assessment to uncover hidden profit leaks and get a customized action plan to scale your contracting business."
>
  <div class="flex min-h-screen flex-col bg-[#13151D] text-white">
    <section class="relative overflow-hidden px-4 pt-20 pb-10 text-center">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(255,138,30,0.12)_0%,transparent_70%)]"></div>
      <h1 class="font-heading mb-6 text-4xl font-bold tracking-tight md:text-6xl">
        Find Exactly Where Your Business is <span class="text-accent-500">Leaking Revenue</span>
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-xl text-white/60">
        Take this 2-minute Local Business Growth Assessment to uncover hidden profit leaks and get a customized action plan to scale your contracting business.
      </p>
      <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-white/80">
        <div class="flex text-accent-500">
          <Icon name="lucide:star" class="h-4 w-4 fill-current" />
          <Icon name="lucide:star" class="h-4 w-4 fill-current" />
          <Icon name="lucide:star" class="h-4 w-4 fill-current" />
          <Icon name="lucide:star" class="h-4 w-4 fill-current" />
          <Icon name="lucide:star" class="h-4 w-4 fill-current" />
        </div>
        Join 1,000+ contractors who used this tool to find clarity.
      </div>
    </section>

    <section class="flex flex-1 flex-col items-center justify-center px-4 py-10">
      <div id="quiz-shell" class="relative w-full max-w-3xl overflow-hidden rounded-3xl border border-white/10 bg-[#1A1D27] shadow-2xl">
        <div class="absolute top-0 left-0 h-1.5 w-full bg-black/50">
          <div id="progress-bar" class="h-full w-0 bg-accent-500 transition-all duration-300 ease-out"></div>
        </div>

        <div class="p-8 pt-12 md:p-12 md:pt-16">
          <div class="mb-12 text-center">
            <span id="question-badge" class="mb-6 inline-block rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm font-medium tracking-wider text-white/60 uppercase"></span>
            <h2 id="question-text" class="font-heading mb-4 text-3xl leading-tight font-bold md:text-4xl"></h2>
            <p id="question-exp" class="text-lg text-white/50"></p>
          </div>

          <div class="mb-8 rounded-3xl border border-white/10 bg-[#1A1D27] p-6 shadow-2xl md:p-10">
            <div id="answers" class="mb-4 grid grid-cols-5 gap-2 md:grid-cols-10 md:gap-3"></div>
            <div class="flex justify-between px-2 text-sm font-medium text-white/40">
              <span>Not doing this</span>
              <span>Mastered</span>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <button id="back-btn" type="button" class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-semibold text-white/60 transition hover:bg-white/5 hover:text-white disabled:cursor-not-allowed disabled:opacity-30">
              <Icon name="lucide:chevron-left" class="mr-1 h-5 w-5" /> Back
            </button>
            <button id="next-btn" type="button" class="inline-flex h-12 items-center rounded-full bg-white/10 px-8 text-base font-semibold text-white/40 transition">
              <span id="next-btn-label">Next Question</span>
              <Icon id="next-btn-icon" name="lucide:chevron-right" class="ml-1 h-5 w-5" />
            </button>
          </div>
        </div>
      </div>

      <div id="results-shell" class="hidden w-full max-w-4xl">
        <div id="results-content"></div>
      </div>
    </section>

    <section class="border-t border-white/5 bg-black/20 py-24">
      <div class="mx-auto max-w-3xl px-4">
        <div class="mb-16 text-center">
          <h2 class="font-heading mb-4 text-3xl font-bold">Frequently Asked Questions</h2>
          <p class="text-white/60">Everything you need to know about the Growth Score assessment.</p>
        </div>
        <div class="assessments-faq">
          <FaqAccordion items={faqs} />
        </div>
      </div>
    </section>

    <section class="border-t border-white/5 bg-[#13151D] py-24">
      <div class="mx-auto mb-12 max-w-3xl px-4 text-center">
        <h2 class="font-heading mb-4 text-3xl font-bold">What Trade Businesses Are Saying</h2>
        <p class="text-white/60">Real results from contractors using our systems.</p>
      </div>
      <div class="mx-auto max-w-6xl space-y-12 px-4">
        <ReviewWidget />
      </div>
    </section>
  </div>
</Layout>

<style>
  .assessments-faq :global(.divide-neutral-200) {
    background-color: #1a1d27;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .assessments-faq :global(.divide-neutral-200 > *) {
    border-color: rgba(255, 255, 255, 0.1);
  }
  .assessments-faq :global(summary span) {
    color: #ffffff;
  }
  .assessments-faq :global(summary svg) {
    color: var(--color-accent-500, #ff8a1e);
  }
  .assessments-faq :global(details > div) {
    color: rgba(255, 255, 255, 0.6);
  }
</style>

<script define:vars={{ categories, BOOKING_URL }}>
  const questions = [];
  categories.forEach((category) => {
    category.questions.forEach((question) => {
      questions.push({ ...question, category: category.name });
    });
  });

  const state = {
    currentStep: 0,
    scores: Array(questions.length).fill(0),
  };

  const questionBadge = document.getElementById("question-badge");
  const questionText = document.getElementById("question-text");
  const questionExp = document.getElementById("question-exp");
  const answers = document.getElementById("answers");
  const backBtn = document.getElementById("back-btn");
  const nextBtn = document.getElementById("next-btn");
  const nextBtnLabel = document.getElementById("next-btn-label");
  const nextBtnIcon = document.getElementById("next-btn-icon");
  const progressBar = document.getElementById("progress-bar");
  const quizShell = document.getElementById("quiz-shell");
  const resultsShell = document.getElementById("results-shell");
  const resultsContent = document.getElementById("results-content");

  function renderQuestion() {
    const q = questions[state.currentStep];
    const progress = (state.currentStep / questions.length) * 100;
    const currentScore = state.scores[state.currentStep];

    if (questionBadge) questionBadge.textContent = `${q.category} • Question ${state.currentStep + 1} of ${questions.length}`;
    if (questionText) questionText.textContent = q.q;
    if (questionExp) questionExp.textContent = q.exp;
    if (progressBar) progressBar.style.width = `${progress}%`;

    if (answers) {
      answers.innerHTML = "";
      for (let num = 1; num <= 10; num++) {
        const button = document.createElement("button");
        button.type = "button";
        const active = currentScore === num;
        button.className = `h-14 md:h-16 rounded-xl text-lg font-bold transition-all duration-200 border ${
          active
            ? "bg-accent-500 border-accent-500 text-white scale-105 shadow-[0_0_20px_rgba(255,138,30,0.4)]"
            : "bg-white/5 border-white/10 text-white hover:bg-white/10 hover:border-white/20"
        }`;
        button.textContent = String(num);
        button.addEventListener("click", () => {
          state.scores[state.currentStep] = num;
          renderQuestion();
        });
        answers.appendChild(button);
      }
    }

    if (backBtn) backBtn.disabled = state.currentStep === 0;
    if (nextBtn) {
      const hasScore = currentScore > 0;
      nextBtn.disabled = !hasScore;
      nextBtn.className = `inline-flex h-12 items-center rounded-full px-8 text-base font-semibold transition ${
        hasScore ? "bg-accent-500 text-white hover:bg-accent-600" : "bg-white/10 text-white/40"
      }`;
      if (nextBtnLabel) nextBtnLabel.textContent = state.currentStep === questions.length - 1 ? "See My Results" : "Next Question";
      if (nextBtnIcon) nextBtnIcon.classList.toggle("hidden", state.currentStep === questions.length - 1);
    }
  }

  function calculateResults() {
    const totalScore = state.scores.reduce((sum, score) => sum + score, 0);

    let status = {
      title: "Leaking Revenue",
      desc: "Your business is currently losing leads, jobs, and repeat customers due to missing systems.",
    };
    if (totalScore >= 90) {
      status = { title: "Growth Operator", desc: "You have strong systems in place. Now it's about scaling and optimization." };
    } else if (totalScore >= 50) {
      status = { title: "Untapped Potential", desc: "You have a foundation, but you're leaving significant revenue on the table." };
    }

    const scoredQuestions = questions.map((question, index) => ({ ...question, score: state.scores[index], index }));
    const lowestScores = [...scoredQuestions].sort((a, b) => a.score - b.score).slice(0, 3);

    const categoryScores = categories.map((category) => {
      const categoryQuestions = questions.filter((question) => question.category === category.name);
      const score = categoryQuestions.reduce((sum, question) => sum + state.scores[questions.indexOf(question)], 0);
      return { name: category.name, score };
    });

    return { totalScore, categoryScores, status, lowestScores };
  }

  function showResults() {
    const { totalScore, categoryScores, status, lowestScores } = calculateResults();

    if (quizShell) quizShell.classList.add("hidden");
    if (resultsShell) resultsShell.classList.remove("hidden");
    if (resultsContent) {
      resultsContent.innerHTML = `
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold font-heading mb-4">Your Growth Score</h1>
          <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-[#1A1D27] border-4 border-accent-500 shadow-[0_0_40px_rgba(255,138,30,0.2)] mb-6">
            <span class="text-5xl font-black text-accent-500">${totalScore}</span>
          </div>
          <h2 class="text-3xl font-bold mb-2">${status.title}</h2>
          <p class="text-xl text-white/60">${status.desc}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-16">
          ${categoryScores
            .map((category) => {
              const percentage = (category.score / 40) * 100;
              const colorClass = percentage >= 70 ? "bg-emerald-500" : percentage >= 45 ? "bg-amber-500" : "bg-red-500";
              return `
                <div class="bg-[#1A1D27] rounded-2xl p-6 border border-white/10">
                  <div class="flex justify-between items-end mb-4">
                    <h3 class="font-semibold">${category.name}</h3>
                    <span class="text-2xl font-bold">${category.score}<span class="text-sm text-white/40">/40</span></span>
                  </div>
                  <div class="h-2 w-full bg-black/50 rounded-full overflow-hidden">
                    <div class="h-full rounded-full ${colorClass} transition-all duration-1000" style="width: ${percentage}%"></div>
                  </div>
                </div>
              `;
            })
            .join("")}
        </div>

        <div class="mb-16">
          <h3 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <span class="inline-flex text-accent-500">${ALERT_CIRCLE_SVG}</span>
            Your Top Priority Fixes
          </h3>
          <div class="space-y-6">
            ${lowestScores
              .map(
                (item) => `
              <div class="bg-[#1A1D27] rounded-2xl p-6 md:p-8 border border-white/10 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-accent-500"></div>
                <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
                  <div class="shrink-0 w-12 h-12 rounded-full bg-white/5 flex items-center justify-center text-xl font-bold text-white/40">
                    ${item.score}/10
                  </div>
                  <div>
                    <h4 class="text-lg font-bold mb-2">${item.q}</h4>
                    <p class="text-white/80 leading-relaxed">${item.tip}</p>
                  </div>
                </div>
              </div>
            `
              )
              .join("")}
          </div>
        </div>

        <div class="text-center bg-gradient-to-b from-[#1A1D27] to-[#13151D] rounded-3xl p-8 md:p-12 border border-white/10 relative overflow-hidden">
          <div class="absolute inset-0" style="background: radial-gradient(circle at center, rgba(255,138,30,0.1) 0%, transparent 70%);"></div>
          <h3 class="text-3xl font-bold mb-4 relative z-10">Stop Leaking Revenue</h3>
          <p class="text-lg text-white/60 mb-8 max-w-2xl mx-auto relative z-10">
            Let's fix these gaps in your business. Book a free growth audit and we'll show you exactly how to implement these systems.
          </p>
          <a href="${BOOKING_URL}" target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex h-14 items-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white shadow-[0_0_30px_rgba(255,138,30,0.3)] hover:bg-accent-600 transition-colors">
            Book My Free Growth Audit ${ARROW_RIGHT_SVG}
          </a>
        </div>
      `;
    }
  }

  const ALERT_CIRCLE_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  const ARROW_RIGHT_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 w-5 h-5 inline"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';

  if (nextBtn) {
    nextBtn.addEventListener("click", () => {
      if (state.scores[state.currentStep] === 0) return;
      if (state.currentStep < questions.length - 1) {
        state.currentStep += 1;
        renderQuestion();
      } else {
        showResults();
      }
    });
  }

  if (backBtn) {
    backBtn.addEventListener("click", () => {
      if (state.currentStep > 0) {
        state.currentStep -= 1;
        renderQuestion();
      }
    });
  }

  renderQuestion();
</script>
