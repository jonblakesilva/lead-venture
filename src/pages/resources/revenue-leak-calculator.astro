---
import Layout from "@/layouts/Layout.astro";
import RoiCalculator from "@/components/RoiCalculator";
---

<Layout title="$50K Leak Finder" description="Estimate how much missed calls, slow responses, and old leads are costing your business.">
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-5 text-center">
      <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">Revenue Recovery</p>
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-primary-900 leading-tight">$50K Leak Finder</h1>
      <p class="text-neutral-500 text-lg mt-4 max-w-2xl mx-auto leading-relaxed">
        Adjust the sliders to estimate how much revenue your business could recover by fixing missed calls, slow responses, and reactivating old contacts.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-5xl mx-auto px-5">
      <div class="rounded-2xl border bg-white p-6 shadow-sm">
        <RoiCalculator client:load />
      </div>
    </div>
  </section>
</Layout>
