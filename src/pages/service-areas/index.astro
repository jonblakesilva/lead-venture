---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";
import Cta from "@/components/cta.astro";

const locations = (await getCollection("locations", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Service Areas"
  description={`${business.name} serves ${business.city}, ${business.state} and surrounding communities within a ${business.serviceRadius}. See all locations we cover.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-16 lg:py-20">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <p class="text-accent-400 font-semibold text-sm uppercase tracking-widest mb-4">Coverage</p>
      <h1 class="font-heading text-4xl lg:text-5xl font-bold text-white leading-tight">Areas We Serve</h1>
      <p class="text-white/70 text-lg mt-4 max-w-2xl">
        We serve {business.city}, {business.state} and communities within a {business.serviceRadius}.
        Don't see your city? Call us — we may still cover your area.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {locations.map((location, i) => (
          <a
            href={`/service-areas/${location.data.urlSlug}`}
            class="group flex flex-col bg-white border-2 border-neutral-200 rounded-2xl p-7 hover:border-accent-400 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={Math.min(i + 1, 6) * 100}
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary-50 text-primary-700 group-hover:bg-accent-500 group-hover:text-white rounded-xl flex items-center justify-center transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="font-heading font-bold text-lg text-primary-900 group-hover:text-accent-600 transition-colors leading-tight">
                  {location.data.city}
                </h2>
                <p class="text-neutral-400 text-xs">{location.data.state}</p>
              </div>
            </div>

            {location.data.shortDesc && (
              <p class="text-neutral-500 text-sm leading-relaxed flex-1">{location.data.shortDesc}</p>
            )}

            <span class="inline-flex items-center gap-1 mt-5 text-sm font-semibold text-accent-600 group-hover:gap-2 transition-all">
              View details
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Not listed callout -->
      <div class="bg-white border-2 border-neutral-200 rounded-2xl p-8 text-center" data-aos="fade-up">
        <h2 class="font-heading font-bold text-xl text-primary-900">Don't see your city?</h2>
        <p class="text-neutral-500 text-sm mt-2 mb-6">
          Our service area is growing. Give us a call and we'll let you know if we cover your address.
        </p>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 py-3 rounded-xl transition-colors text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.5 11.5 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.57 3.6 1 1 0 01-.24 1.01l-2.21 2.18z"/>
          </svg>
          Call {business.phone}
        </a>
      </div>
    </div>
  </section>

  <Cta />
</Layout>
