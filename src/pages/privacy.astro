---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const effectiveDate = "January 1, 2025"; // CUSTOMIZE: update to your actual effective date
const lastUpdated   = "January 1, 2025"; // CUSTOMIZE: update when you revise this policy
---

<Layout
  title="Privacy Policy"
  description={`Privacy Policy for ${business.name}. Learn how we collect, use, and protect your personal information.`}
>
  <!-- Header -->
  <section class="bg-primary-900 text-white py-14">
    <div class="max-w-(--breakpoint-xl) mx-auto px-5">
      <h1 class="font-heading text-3xl lg:text-4xl font-bold text-white">Privacy Policy</h1>
      <p class="text-white/60 text-sm mt-2">Effective: {effectiveDate} · Last updated: {lastUpdated}</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-5">
      <div class="prose prose-neutral max-w-none">

        <p>
          {business.name} ("we," "our," or "us") is committed to protecting your privacy.
          This Privacy Policy explains how we collect, use, and safeguard information when
          you visit our website or contact us for services.
        </p>

        <h2>Information We Collect</h2>

        <h3>Information You Provide</h3>
        <ul>
          <li><strong>Contact forms:</strong> Name, phone number, email address, service type, and any details you include in your message.</li>
          <li><strong>Phone calls:</strong> Name and contact information you provide when calling us.</li>
          <li><strong>Email correspondence:</strong> Any information included in emails you send to us.</li>
        </ul>

        <h3>Information Collected Automatically</h3>
        <ul>
          <li><strong>Usage data:</strong> Pages visited, time on site, and referring URLs (via standard web analytics).</li>
          <li><strong>Device information:</strong> Browser type, device type, and IP address.</li>
          <li><strong>Cookies:</strong> We use cookies for analytics and to improve site performance. You can disable cookies in your browser settings.</li>
        </ul>

        <h2>How We Use Your Information</h2>
        <p>We use the information we collect to:</p>
        <ul>
          <li>Respond to your quote requests and service inquiries</li>
          <li>Schedule and deliver services you've requested</li>
          <li>Send service confirmations, reminders, and follow-up communications</li>
          <li>Improve our website and service offerings</li>
          <li>Comply with legal obligations</li>
        </ul>
        <p>We do <strong>not</strong> sell, rent, or trade your personal information to third parties for their marketing purposes.</p>

        <h2>How We Share Your Information</h2>
        <p>We may share your information with:</p>
        <ul>
          <li><strong>Service providers:</strong> Third-party vendors who help us operate our website (e.g., form submission services, analytics providers). These partners are contractually obligated to protect your data.</li>
          <li><strong>Legal requirements:</strong> When required by law, court order, or government authority.</li>
          <li><strong>Business transfers:</strong> In connection with a merger, acquisition, or sale of business assets.</li>
        </ul>

        <h2>Data Retention</h2>
        <p>
          We retain customer contact information for as long as necessary to provide services and meet legal obligations.
          If you'd like us to delete your information, contact us at <a href={`mailto:${business.email}`}>{business.email}</a>.
        </p>

        <h2>Your Rights</h2>
        <p>Depending on your location, you may have the right to:</p>
        <ul>
          <li>Access the personal information we hold about you</li>
          <li>Correct inaccurate information</li>
          <li>Request deletion of your information</li>
          <li>Opt out of marketing communications</li>
        </ul>
        <p>To exercise any of these rights, contact us at <a href={`mailto:${business.email}`}>{business.email}</a> or call <a href={`tel:${business.phoneRaw}`}>{business.phone}</a>.</p>

        <h2>Cookies</h2>
        <p>
          Our website uses cookies to analyze traffic and improve performance. By using our site, you consent to our use of cookies.
          You can control cookie settings through your browser preferences. Note that disabling cookies may affect some site functionality.
        </p>

        <h2>Third-Party Links</h2>
        <p>
          Our website may contain links to third-party websites (e.g., Google Maps, review platforms). We are not responsible for
          the privacy practices of those sites and encourage you to review their policies.
        </p>

        <h2>Children's Privacy</h2>
        <p>
          Our services are not directed to children under 13. We do not knowingly collect personal information from children.
          If you believe we have inadvertently collected such information, please contact us immediately.
        </p>

        <h2>Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated effective date.
          Continued use of our website after changes constitutes acceptance of the updated policy.
        </p>

        <h2>Contact Us</h2>
        <p>If you have questions about this Privacy Policy, please contact us:</p>
        <ul>
          <li><strong>Business:</strong> {business.name}</li>
          <li><strong>Phone:</strong> <a href={`tel:${business.phoneRaw}`}>{business.phone}</a></li>
          <li><strong>Email:</strong> <a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li><strong>Location:</strong> {business.city}, {business.state} {business.zip}</li>
        </ul>

      </div>
    </div>
  </section>
</Layout>
