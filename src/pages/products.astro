---
import Layout from "@/layouts/Layout.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Modern Website",
    description: "Stop losing jobs because your website looks outdated. We build fast, beautiful sites designed specifically to convert visitors into leads.",
    items: ["Mobile-responsive design", "Built-in lead capture forms", "Lightning fast loading speeds", "Local SEO optimized structure"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/9eaa31a4-3106-4938-b024-cb23c678a57e.png",
    slug: "website",
    caseStudyLink: "/proof/website-rebuild-case-study",
    caseStudyTitle: "Read the Website Case Study",
  },
  {
    title: "Business Mobile App",
    description: "Run your entire business from the truck. See all your leads, messages, and reviews in one simple app.",
    items: ["All leads in one place", "Manage your calendar on the go", "Respond to messages instantly", "Request reviews from the job site"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/1e8bf1c1-f136-46bc-8625-ab1ede39a28b.png",
    slug: "mobile-app",
  },
  {
    title: "5-Star Auto Review System",
    description: "More reviews mean more trust and better Google rankings. Our system asks for reviews automatically when a job is done.",
    items: ["Automated SMS review requests", "Negative feedback filtered privately", "Boost your Google Maps ranking", "Monitor your reputation 24/7"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/11ae4843-bffa-41ed-a71f-212f82de5351.png",
    slug: "reviews",
    caseStudyLink: "/proof/reputation-case-study",
    caseStudyTitle: "Read the Reputation Case Study",
  },
  {
    title: "Missed Call Text-Back",
    description: "Never lose a lead to voicemail again. When you miss a call, our system instantly texts them back to start a conversation.",
    items: ["Instant text response", "Custom messaging", "Lead capture", "24/7 coverage"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/94adcac0-6ebb-4bfc-81ee-6c9f05886405.png",
    slug: "missed-call-text-back",
  },
  {
    title: "Revenue Campaigns",
    description: "Turn past customers into repeat business with done-for-you email and SMS campaigns that drive seasonal revenue.",
    items: ["Email + SMS campaigns", "Seasonal promotions", "Customer retention", "One-click send"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/c17c583d-a6ea-4eb4-b312-1489d9caa75d.png",
    slug: "rev-gen-campaigns",
    caseStudyLink: "/proof/reactivation-case-study",
    caseStudyTitle: "Read the Reactivation Case Study",
  },
  {
    title: "Local SEO",
    description: "Dominate your local market. We optimize your Google Business Profile to get you ranking in the top 3 map pack results.",
    items: ["Google Business optimization", "Local citation building", "Map pack visibility", "Keyword ranking"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/b13ba67a-f80f-4149-84ba-ad948d602a68.png",
    slug: "local-seo",
    caseStudyLink: "/proof/seo-case-study",
    caseStudyTitle: "Read the Local SEO Case Study",
  },
  {
    title: "3-Click Ad System",
    description: "Launch high-converting Facebook, Instagram, and Google ads in seconds using pre-built, proven contractor templates without paying heavy agency retainers.",
    items: ["Launch ads in just 3 clicks", "Pre-tested contractor templates for Meta & Google", "Automated lead sync to CRM & SMS follow-up", "Zero agency retainers required"],
    image: "https://vibe.filesafe.space/1785706415045236708/attachments/997d77ac-88de-4c95-8255-032efbe16a24.png",
    slug: "3-click-ad-system",
  },
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Contractor Growth System Products",
  itemListElement: features.map((f) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Product", name: f.title },
  })),
};
---

<Layout title="Products & Growth Tools for Trade Contractors" description="Explore our high-converting modern websites, 3-Click Ad System, 5-Star Review Funnels, Missed Call Text-Back, and Local SEO tools built for contractors.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  </Fragment>

  <section class="border-b border-white/10 bg-[#1A1D27] py-20 text-white">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5 text-center">
      <h1 class="font-heading text-4xl font-bold md:text-6xl">Everything You Need to Grow Your Business</h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-white/70">A complete suite of tools to help you manage leads, close more deals, and get paid faster.</p>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-(--breakpoint-xl) space-y-32 px-5">
      {features.map((feature, i) => (
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div class:list={["order-2 space-y-6", i % 2 === 0 ? "md:order-1" : "md:order-2"]}>
            <h2 class="text-3xl font-bold text-slate-900">{feature.title}</h2>
            <p class="text-lg text-slate-600">{feature.description}</p>
            <ul class="space-y-3">
              {feature.items.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="lucide:check-circle-2" class="h-6 w-6 shrink-0 text-accent-500" />
                  <span class="text-slate-700">{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <a href={`/products/${feature.slug}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-accent-600">
                Learn More <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
              {feature.caseStudyLink && (
                <a href={feature.caseStudyLink} class="inline-flex items-center gap-1.5 text-base font-semibold text-accent-600 hover:text-accent-700">
                  {feature.caseStudyTitle} <Icon name="lucide:arrow-right" class="h-3 w-3" />
                </a>
              )}
            </div>
          </div>
          <div class:list={["order-1 flex items-center justify-center rounded-2xl bg-slate-100 p-8", i % 2 === 0 ? "md:order-2" : "md:order-1"]}>
            <img src={feature.image} alt={`${feature.title} Mockup`} loading="lazy" class="h-auto w-full max-w-md rounded-lg border object-contain shadow-xl" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-white/10 bg-[#1A1D27] py-24 text-center text-white">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <h2 class="mb-6 text-4xl font-bold">Ready to Get Started?</h2>
      <div class="mb-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="inline-flex h-14 w-full items-center justify-center rounded-xl bg-accent-500 px-8 text-base font-semibold text-white transition-colors hover:bg-accent-600 sm:w-auto">Request a Website</a>
        <a href="/pricing" class="inline-flex h-14 w-full items-center justify-center rounded-xl border border-white/20 px-8 text-base font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto">View Pricing</a>
      </div>
      <div class="flex flex-col items-center gap-3 text-sm text-white/70">
        <div class="flex flex-wrap justify-center gap-4 md:gap-6">
          <div class="flex items-center gap-1.5"><Icon name="lucide:check-circle-2" class="h-4 w-4 text-accent-400" /> $0 upfront, website live in as little as 72 hours</div>
          <div class="flex items-center gap-1.5"><Icon name="lucide:check-circle-2" class="h-4 w-4 text-accent-400" /> 40+ websites launched and counting</div>
          <div class="flex items-center gap-1.5"><Icon name="lucide:check-circle-2" class="h-4 w-4 text-accent-400" /> Average client stays 30+ months</div>
        </div>
        <div class="flex flex-wrap justify-center gap-4 md:gap-6">
          <div class="flex items-center gap-1.5"><Icon name="lucide:check-circle-2" class="h-4 w-4 text-accent-400" /> No contracts. No risk. Cancel anytime.</div>
          <div class="flex items-center gap-1.5"><Icon name="lucide:check-circle-2" class="h-4 w-4 text-accent-400" /> Built by actual trade operators</div>
        </div>
      </div>
    </div>
  </section>

  <TestimonialCarousel />
</Layout>
