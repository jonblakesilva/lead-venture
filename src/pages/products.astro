---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const features = [
  {
    title: "Modern Website Systems",
    subtitle: "Designed to convert local visibility into booked jobs.",
    description: "High-performing websites with clear calls-to-action, service pages, trust signals, and lead-capture flows built to turn local demand into booked work.",
    icon: "⚡",
  },
  {
    title: "Review & Reputation Funnel",
    subtitle: "Automate review requests without extra work.",
    description: "Collect more 5-star reviews from happy customers through timed follow-ups, review links, and a simple customer experience designed to create social proof.",
    icon: "★",
  },
  {
    title: "Missed-Call Text Back",
    subtitle: "Recover leads you would otherwise lose.",
    description: "When a customer calls and misses the answer, your system instantly follows up with a text, qualifying the lead and creating a faster path to a booked visit.",
    icon: "📲",
  },
  {
    title: "AI Receptionist",
    subtitle: "Answer more calls even after hours.",
    description: "Your AI receptionist answers, qualifies, and routes incoming leads while your team focuses on the jobs already booked.",
    icon: "🎙",
  },
  {
    title: "Local SEO & Visibility",
    subtitle: "Capture demand in your service area.",
    description: "We build the technical and local SEO foundation that makes your business easier to find when homeowners are searching for the exact service you offer.",
    icon: "📍",
  },
  {
    title: "Re-Marketing Campaigns",
    subtitle: "Bring old leads back when they're ready.",
    description: "Keep your brand in front of past inquiries and warm leads with a steady retargeting system designed to convert missed opportunities into booked work.",
    icon: "↺",
  },
];
---

<Layout title="Products & Services" description={`Explore the core tools and growth systems behind ${business.name}, including lead generation, reviews, AI follow-up, and local SEO for contracting businesses.`}>
  <section class="bg-[#1A1D27] py-16 text-white md:py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The growth stack</p>
        <h1 class="font-heading text-4xl font-bold leading-tight md:text-5xl">Built to turn attention into booked work.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
          Every piece of the lead engine is intentionally designed around the same goal: more qualified opportunities, faster follow-up, and a cleaner customer journey from first click to first job.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F9FA] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-8 lg:grid-cols-2 xl:grid-cols-3">
        {features.map((feature) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-100 text-2xl">{feature.icon}</div>
            <h2 class="text-2xl font-bold text-primary-900">{feature.title}</h2>
            <p class="mt-3 text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">{feature.subtitle}</p>
            <p class="mt-4 text-slate-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="rounded-3xl bg-[#1A1D27] p-8 text-white shadow-xl lg:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The result</p>
            <h2 class="font-heading text-4xl font-bold leading-tight md:text-5xl">More opportunities. Less manual chasing.</h2>
          </div>
          <div class="space-y-4 text-lg text-white/80">
            <p>• Stronger visibility in your service area</p>
            <p>• Faster lead response times and better follow-up</p>
            <p>• A reliable review and trust system that grows with you</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
