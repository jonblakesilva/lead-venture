---
import Layout from "@/layouts/Layout.astro";
import { business } from "@/config/business";

const features = [
  {
    title: "Modern Website",
    slug: "website",
    subtitle: "Turn traffic into high-paying jobs.",
    description: "Professional, mobile-first websites built to convert visitors into paying customers. Stand out from competitors with stunning design that captures leads 24/7.",
    icon: "⚡",
    caseStudyLink: "/proof/website-rebuild-case-study",
    caseStudyTitle: "Read the Website Case Study",
  },
  {
    title: "Business Mobile App",
    slug: "mobile-app",
    subtitle: "Run your entire business from your pocket.",
    description: "See all your leads, messages, and reviews in one simple app. Manage your calendar, respond to messages instantly, and request reviews from the job site.",
    icon: "📱",
  },
  {
    title: "5-Star Auto Review System",
    slug: "reviews",
    subtitle: "Automate review requests without extra work.",
    description: "More reviews mean more trust and better Google rankings. Our system asks for reviews automatically when a job is done, and filters negative feedback privately.",
    icon: "★",
    caseStudyLink: "/proof/reputation-case-study",
    caseStudyTitle: "Read the Reputation Case Study",
  },
  {
    title: "Missed Call Text-Back",
    slug: "missed-call-text-back",
    subtitle: "Recover leads you would otherwise lose.",
    description: "Never lose a lead to voicemail again. When you miss a call, our system instantly texts them back to start a conversation and keep them engaged.",
    icon: "📲",
    caseStudyLink: "/proof/speed-to-lead-case-study",
    caseStudyTitle: "Read the Speed-to-Lead Case Study",
  },
  {
    title: "Local SEO",
    slug: "local-seo",
    subtitle: "Dominate your local market.",
    description: "We optimize your Google Business Profile, build citations, and target the exact local keywords your customers are searching for to get you into the top of the map pack.",
    icon: "📍",
    caseStudyLink: "/proof/seo-case-study",
    caseStudyTitle: "Read the Local SEO Case Study",
  },
  {
    title: "Revenue Campaigns",
    slug: "rev-gen-campaigns",
    subtitle: "Turn past customers into repeat business.",
    description: "Stay top-of-mind with past customers through strategic email and SMS campaigns that drive repeat business, seasonal promotions, and referrals.",
    icon: "↺",
    caseStudyLink: "/proof/reactivation-case-study",
    caseStudyTitle: "Read the Reactivation Case Study",
  },
  {
    title: "3-Click Ad System",
    slug: "3-click-ad-system",
    subtitle: "Launch high-converting ads in seconds.",
    description: "Launch pre-built, proven contractor ad templates on Meta and Google in just 3 clicks, without paying heavy agency retainers.",
    icon: "🎯",
  },
];
---

<Layout title="Products & Services" description={`Explore the core tools and growth systems behind ${business.name}, including lead generation, reviews, AI follow-up, and local SEO for contracting businesses.`}>
  <section class="bg-[#1A1D27] py-16 text-white md:py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The growth stack</p>
        <h1 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-6xl">Built to turn attention into booked work.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75">
          Every piece of the system is designed around the same goal: more qualified leads, faster follow-up, and less chaos in your sales process.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F9FA] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-8 lg:grid-cols-2 xl:grid-cols-3">
        {features.map((feature) => (
          <div class="flex flex-col rounded-[28px] border border-slate-200 bg-white p-7 shadow-sm">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-100 text-2xl">{feature.icon}</div>
            <h2 class="text-2xl font-bold text-primary-900">{feature.title}</h2>
            <p class="mt-3 text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">{feature.subtitle}</p>
            <p class="mt-4 flex-1 text-base leading-relaxed text-slate-600">{feature.description}</p>
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <a href={`/products/${feature.slug}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 hover:text-accent-700">
                Learn More →
              </a>
              {feature.caseStudyLink && (
                <a href={feature.caseStudyLink} class="text-sm font-medium text-slate-500 hover:text-slate-700">
                  {feature.caseStudyTitle}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">How it works</p>
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">One system. More booked jobs.</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-[28px] border border-slate-200 bg-slate-50 p-6">
          <div class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">01</div>
          <h3 class="text-2xl font-bold text-primary-900">Get found</h3>
          <p class="mt-3 text-slate-600">Your site and local visibility work together so homeowners find you when they need your service.</p>
        </div>
        <div class="rounded-[28px] border border-slate-200 bg-slate-50 p-6">
          <div class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">02</div>
          <h3 class="text-2xl font-bold text-primary-900">Convert faster</h3>
          <p class="mt-3 text-slate-600">Clear offers, trust signals, and faster response logic help people book instead of bouncing.</p>
        </div>
        <div class="rounded-[28px] border border-slate-200 bg-slate-50 p-6">
          <div class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">03</div>
          <h3 class="text-2xl font-bold text-primary-900">Stay in control</h3>
          <p class="mt-3 text-slate-600">AI follow-up, review generation, and reporting keep your pipeline moving even when your crew is on-site.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1A1D27] py-20 text-white">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="rounded-[32px] border border-white/10 bg-white/5 p-8 shadow-xl lg:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The result</p>
            <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-5xl">More opportunities. Less manual chasing.</h2>
          </div>
          <div class="space-y-4 text-lg text-white/80">
            <p>• Stronger visibility in your service area</p>
            <p>• Faster lead response times and better follow-up</p>
            <p>• A review and trust system that compounds over time</p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-accent-500 px-8 text-base font-semibold text-white transition hover:bg-accent-600">Book a strategy call</a>
          <a href="/pricing" class="inline-flex h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 text-base font-semibold text-white transition hover:bg-white/10">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
