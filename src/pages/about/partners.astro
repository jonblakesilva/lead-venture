---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";

const integrationGroups = [
  {
    category: "Payments & Billing",
    tools: [
      { name: "Stripe", icon: "simple-icons:stripe" },
      { name: "PayPal", icon: "simple-icons:paypal" },
      { name: "Authorize.net", icon: "lucide:credit-card" },
      { name: "NMI", icon: "lucide:credit-card" },
      { name: "QuickBooks", icon: "simple-icons:quickbooks" },
    ],
  },
  {
    category: "Calls, Texting & Email",
    tools: [
      { name: "Twilio", icon: "simple-icons:twilio" },
      { name: "Mailgun", icon: "simple-icons:mailgun" },
      { name: "Slack", icon: "simple-icons:slack" },
    ],
  },
  {
    category: "Scheduling",
    tools: [
      { name: "Google Calendar", icon: "simple-icons:googlecalendar" },
      { name: "Zoom", icon: "simple-icons:zoom" },
    ],
  },
  {
    category: "Social, Reviews & Ads",
    tools: [
      { name: "Facebook", icon: "simple-icons:facebook" },
      { name: "Instagram", icon: "simple-icons:instagram" },
      { name: "Google Business Profile", icon: "simple-icons:googlemybusiness" },
      { name: "Google Ads", icon: "simple-icons:googleads" },
      { name: "Google Analytics", icon: "simple-icons:googleanalytics" },
    ],
  },
  {
    category: "E-Commerce & Websites",
    tools: [
      { name: "Shopify", icon: "simple-icons:shopify" },
      { name: "WordPress", icon: "simple-icons:wordpress" },
    ],
  },
  {
    category: "No-Code Automation",
    tools: [
      { name: "Zapier", icon: "simple-icons:zapier" },
      { name: "Make", icon: "simple-icons:make" },
    ],
  },
];
---

<Layout
  title="Partners & Integrations"
  description={`See the tools and platforms behind ${business.name}. We integrate with the tools your business already uses.`}
>
  <section class="border-b border-neutral-200 bg-neutral-50 py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5 text-center">
      <h1 class="font-heading text-4xl font-bold text-primary-900 md:text-6xl">Here’s Who’s in Our Corner</h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-neutral-600">
        We integrate with the best tools in the industry to give you a seamless experience.
      </p>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-4 space-y-16">
      {integrationGroups.map((group) => (
        <div>
          <h2 class="mb-6 text-sm font-bold tracking-wide text-neutral-400 uppercase">{group.category}</h2>
          <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
            {group.tools.map((tool) => (
              <div class="flex h-32 flex-col items-center justify-center gap-3 rounded-xl border border-neutral-200 bg-neutral-50 p-6 text-center shadow-sm">
                <Icon name={tool.icon} class="h-8 w-8 text-neutral-500" />
                <h3 class="text-sm font-bold text-neutral-500">{tool.name}</h3>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="rounded-2xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center">
        <p class="text-lg font-semibold text-primary-900">Plus 1,500+ more apps</p>
        <p class="mx-auto mt-2 max-w-xl text-neutral-600">
          Everything above connects natively. Need something else? Our platform also connects through Zapier and Make to virtually any tool your business already runs on.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-neutral-50 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-6 text-3xl font-bold text-primary-900">Why This Matters</h2>
      <div class="space-y-6 text-left text-lg text-neutral-600">
        <p>
          Instead of duct-taping together 10 different software subscriptions, we’ve built a unified platform that brings the power of these enterprise tools under one roof.
        </p>
        <p>
          When your website talks to your CRM, and your CRM talks to your review platform, and your review platform talks to Google—magic happens. Your business runs smoother, leads don’t fall through the cracks, and you look like a massive, professional operation to your customers.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-24 text-center">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-6 text-4xl font-bold text-primary-900">Ready to Upgrade Your Tech?</h2>
      <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-xl bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">
        Request a Website
      </a>
    </div>
  </section>

  <TestimonialCarousel />
</Layout>
