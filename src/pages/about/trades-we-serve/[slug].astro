---
import Layout from "@/layouts/Layout.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { Icon } from "astro-icon/components";
import { tradeData, tradeSlugs } from "@/data/trades";

export function getStaticPaths() {
  return tradeSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const trade = tradeData[slug as keyof typeof tradeData] ?? tradeData.roofing;

const joinSteps = [
  { step: "1", title: "Demo Call", desc: "A quick 20-minute chat to see if we're a good fit. No pressure, no hard selling." },
  { step: "2", title: "System Buildout", desc: "We spend 7-10 days building your custom website and setting up your CRM." },
  { step: "3", title: "Launch Call", desc: "A 25-minute walkthrough to hand over the keys and show you how to use the app." },
];
---

<Layout title={`${trade.name} Websites & Local Marketing`} description={trade.heroSub}>
  <section class="border-b border-white/10 bg-[#1A1D27] py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5 text-center">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-accent-500/20">
        <Icon name={trade.icon} class="h-8 w-8 text-accent-400" />
      </div>
      <h1 class="mx-auto max-w-4xl font-heading text-4xl font-bold text-white md:text-6xl">
        The Ultimate Growth Platform for <span class="text-accent-400">{trade.highlightWord}</span> Businesses
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-white/70">{trade.heroSub}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">Request a Website</a>
        <a href="/pricing" class="inline-flex h-14 items-center justify-center rounded-full border border-white/20 px-8 text-lg font-semibold text-white transition hover:bg-white/10">View Pricing</a>
      </div>
    </div>
  </section>

  <section class="border-b border-neutral-200 bg-neutral-50 py-16">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-3">
        {trade.stats.map((stat) => (
          <div class="space-y-2 text-center">
            <div class="font-heading text-5xl font-bold text-accent-500">{stat.value}</div>
            <p class="font-medium text-neutral-600">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mb-16 text-center">
        <h2 class="mb-4 font-heading text-3xl font-bold text-primary-900 md:text-4xl">Why The Lead Venture for {trade.name}?</h2>
        <p class="mx-auto max-w-2xl text-lg text-neutral-600">Everything you need to dominate your local market, built into one simple system.</p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
        {trade.benefits.map((benefit) => (
          <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
            <Icon name={benefit.icon} class="mb-6 h-10 w-10 text-accent-500" />
            <h3 class="mb-3 text-xl font-bold text-primary-900">{benefit.title}</h3>
            <p class="leading-relaxed text-neutral-600">{benefit.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#1A1D27] py-16 text-center">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <h2 class="mb-6 font-heading text-2xl font-bold text-white md:text-3xl">Ready to scale your {trade.name.toLowerCase()} business?</h2>
      <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">Schedule a Time to Talk</a>
    </div>
  </section>

  <section class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mb-16 text-center">
        <h2 class="mb-4 font-heading text-3xl font-bold text-primary-900 md:text-4xl">How Do I Join?</h2>
        <p class="text-lg text-neutral-600">Three simple steps to launch your new growth engine.</p>
      </div>
      <div class="relative mx-auto grid max-w-5xl gap-8 md:grid-cols-3">
        <div class="absolute left-1/6 right-1/6 top-12 hidden h-0.5 bg-neutral-200 md:block"></div>
        {joinSteps.map((item) => (
          <div class="relative z-10 flex flex-col items-center rounded-xl border border-neutral-200 bg-white p-6 text-center shadow-sm md:border-none md:bg-transparent md:p-0 md:shadow-none">
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary-900 text-2xl font-bold text-white shadow-lg">
              {item.step}
            </div>
            <h3 class="mb-3 text-xl font-bold text-primary-900">{item.title}</h3>
            <p class="text-neutral-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#1A1D27] py-24 text-center">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <h2 class="mb-6 font-heading text-4xl font-bold text-white">Ready to Get Started?</h2>
      <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-full bg-accent-500 px-8 text-lg font-semibold text-white transition hover:bg-accent-600">Request a Website</a>
    </div>
  </section>

  <TestimonialCarousel />
</Layout>
