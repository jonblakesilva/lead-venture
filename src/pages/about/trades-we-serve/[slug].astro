export function getStaticPaths() {
  return [
    { params: { slug: 'roofing' } },
    { params: { slug: 'hvac' } },
    { params: { slug: 'electrical' } },
    { params: { slug: 'plumbing' } },
    { params: { slug: 'lawn-care' } },
    { params: { slug: 'tree-service' } },
    { params: { slug: 'landscaping' } },
    { params: { slug: 'painting' } },
    { params: { slug: 'remodeling' } },
    { params: { slug: 'general-contractors' } },
    { params: { slug: 'junk-removal' } },
    { params: { slug: 'pest-control' } },
  ];
}

const { slug } = Astro.params;
const trade = tradeData[slug as keyof typeof tradeData] ?? tradeData.roofing;
---

<Layout title={`${trade.name} Growth System`} description={`See how ${trade.name} businesses can generate more leads, reviews, and booked jobs with The Lead Venture.`}>
  <section class="bg-primary-900 py-16 text-white lg:py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">Trade specialty</p>
        <h1 class="font-heading text-4xl font-bold leading-tight md:text-5xl">{trade.name}</h1>
        <p class="mt-6 text-lg text-white/80">{trade.heroSub}</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-6 md:grid-cols-3">
        {trade.stats.map((stat) => (
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-center">
            <div class="font-heading text-4xl font-black text-primary-900">{stat.value}</div>
            <div class="mt-3 text-sm text-neutral-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-neutral-50 py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-heading text-3xl font-bold text-primary-900 md:text-4xl">Why it works</h2>
          <div class="mt-8 space-y-4">
            {trade.benefits.map((benefit) => (
              <div class="flex gap-4 rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
                <div class="mt-1 flex h-8 w-8 items-center justify-center rounded-full bg-accent-100 text-accent-700">✓</div>
                <div class="text-lg font-medium text-neutral-700">{benefit}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-3xl bg-primary-900 p-8 text-white shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The system</p>
          <h3 class="mt-4 text-3xl font-bold">More calls. Better follow-up. Higher-value jobs.</h3>
          <ul class="mt-6 space-y-3 text-white/80">
            <li>• Faster response to missed calls and forms</li>
            <li>• A cleaner sales funnel that nurtures leads</li>
            <li>• Reviews and trust signals that close more work</li>
            <li>• Placeholder content that can be replaced with real client examples</li>
          </ul>
          <a href="/contact" class="mt-8 inline-flex rounded-xl bg-accent-500 px-6 py-3 font-semibold text-white transition hover:bg-accent-600">
            Book a Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
