          <a href="/about/trades-we-serve" class="inline-flex h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 text-sm font-semibold text-white transition hover:bg-white/10">All trade services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">The problem</p>
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">{trade.summaryTitle}</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{trade.summary}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {trade.stats.map((stat) => (
          <div class="rounded-[24px] border border-neutral-200 bg-neutral-50 p-6 text-center shadow-sm">
            <div class="font-heading text-4xl font-black text-primary-900">{stat.value}</div>
            <div class="mt-3 text-sm leading-relaxed text-neutral-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-neutral-50 py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">What we fix</p>
          <h2 class="font-heading text-3xl font-bold text-primary-900 md:text-4xl">The bottlenecks preventing more booked work</h2>
          <div class="mt-8 space-y-4">
            {trade.pains.map((pain) => (
              <div class="flex gap-4 rounded-[22px] border border-neutral-200 bg-white p-5 shadow-sm">
                <div class="mt-1 flex h-8 w-8 items-center justify-center rounded-full bg-accent-100 text-sm font-bold text-accent-700">!</div>
                <div class="text-lg font-medium text-neutral-700">{pain}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-[30px] bg-primary-900 p-8 text-white shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">The fix</p>
          <h3 class="mt-4 text-3xl font-black leading-tight">{trade.systemTitle}</h3>
          <ul class="mt-6 space-y-3 text-white/80">
            {trade.systemBullets.map((bullet) => (
              <li>• {bullet}</li>
            ))}
          </ul>
          <a href="/contact" class="mt-8 inline-flex rounded-xl bg-accent-500 px-6 py-3 font-semibold text-white transition hover:bg-accent-600">
            {trade.ctaText}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-(--breakpoint-xl) px-5">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">Why it works</p>
        <h2 class="font-heading text-4xl font-black leading-[0.95] tracking-[-0.05em] text-primary-900 md:text-5xl">The system built around this trade</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {trade.focusPanels.map((panel) => (
          <div class="rounded-[28px] border border-neutral-200 bg-neutral-50 p-6 shadow-sm">
            <h3 class="text-2xl font-bold text-primary-900">{panel.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">{panel.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 flex justify-center">
        <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-primary-900 px-8 text-base font-semibold text-white transition hover:bg-primary-800">{trade.ctaText}</a>
      </div>
    </div>
  </section>
</Layout>
